+// To view the license please visit https://github.com/IDNI/tau-lang/blob/main/LICENSE.md
+
+#ifndef __IDNI__TAU__CONCRETE_DEFINITION_H__
+#define __IDNI__TAU__CONCRETE_DEFINITION_H__
+
+#include <algorithm>
+#include <cstdlib>
+#include <functional>
+#include <iostream>
+#include <string>
+#include <optional>
+#include <string_view>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "definitions.h"
+#include "tau_tree.h"
+
+namespace idni::tau_lang {
+
+namespace concrete_definition_detail {
+
+enum class type_family { unsupported, bv };
+
+template <NodeType node>
+type_family family_of(tref n) {
+	using tau = tree<node>;
+	const size_t id = get_effective_ba_type<node>(n);
+	if (!id) return type_family::unsupported;
+	tref type = get_ba_type_tree<node>(id);
+	if (!type || !tau::get(type).children_size())
+		return type_family::unsupported;
+	const std::string& name = tau::get(type)[0].get_string();
+	// A family-only `bv` has no fixed carrier.  Accept only a concrete
+	// bit-width established by inference.
+	if (name == "bv" && !type_needs_param<node>(id))
+		return type_family::bv;
+	return type_family::unsupported;
+}
+
+template <NodeType node>
+bool only_typed_after(tref n, size_t first) {
+	using tau = tree<node>;
+	const auto& t = tau::get(n);
+	for (size_t i = first; i < t.children_size(); ++i)
+		if (!t[i].is(tau::typed)) return false;
+	return true;
+}
+
+} // namespace concrete_definition_detail
+
+// ------------------------------------------------------------------
+// Extension: concrete conditional definitions (TAU_CONCRETE_EVAL).
+//
+// A formula (or the body of a single `always`) is admitted when it is a
+// conditional DAG
+//     F ::= (G ? F : F) | L
+// whose guards G are total wffs over input variables only and whose leaves
+// L are conjunctions `o = term` defining every output exactly once, each
+// term total over inputs and over outputs of the same leaf in a checked
+// acyclic order.  Inputs are current-time (`[t]`) input streams; outputs
+// are current-time output streams, or, for a ground `solve` query, plain
+// variables (then no variable may occur in a guard).  Every leaf must
+// define the same output set.  Anything else is rejected, and the caller
+// falls back to the existing path.  Only bv terms of a concrete width are
+// admitted; every operator admitted here is one the bv translator
+// (bv_eval_node) implements, so evaluation uses the existing algebra.
+// ------------------------------------------------------------------
+
+// Source line of the last admission rejection (diagnostics only).
+inline int concrete_reject_line = 0;
+// Set when the last rejection was the admission budget (diagnostics only).
+inline bool concrete_reject_over_budget = false;
+#define CONCRETE_REJECT(v) return (concrete_reject_line \
+	? concrete_reject_line : (concrete_reject_line = __LINE__), (v))
+
+template <NodeType node>
+struct concrete_definition {
+	struct variable_ref {
+		tref var;          // the `variable` node (translator key)
+		size_t slot;       // index into input_names / output_names
+	};
+	struct leaf {
+		std::vector<tref> terms;     // terms[k] defines output k
+		std::vector<tref> lhs;       // lhs[k]: the clause's left `bf`
+		std::vector<size_t> order;   // evaluation order of output slots
+	};
+	struct branch { tref guard; size_t yes; size_t no; };
+	struct dag_node { bool is_leaf; size_t index; };
+	std::vector<dag_node> nodes;             // nodes[0] is the root
+	std::vector<branch> branches;
+	std::vector<leaf> leaves;
+	std::vector<variable_ref> inputs;        // distinct input variable nodes
+	std::vector<std::string> input_names;    // distinct printed names
+	std::vector<size_t> input_types;         // ba type id per name
+	std::vector<variable_ref> outputs;       // distinct output variable nodes
+	std::vector<std::string> output_names;
+	std::vector<size_t> output_types;
+	size_t expression_count = 0;             // admitted wff/bf occurrences
+};
+
+namespace concrete_definition_detail {
+
+enum class var_class { rejected, input, output };
+
+// Classifies a `variable` node.  A plain variable is an output of a
+// ground query (allow_io == false).  A current-time io stream is an
+// input or output by its direction.  Member paths (flattened tuple
+// members) and type annotations may follow the head.
+template <NodeType node>
+var_class classify_variable(tref var, bool allow_io) {
+	using tau = tree<node>;
+	const auto& v = tau::get(var);
+	if (!v.is(tau::variable) || !v.children_size()) CONCRETE_REJECT(var_class::rejected);
+	for (size_t i = 1; i < v.children_size(); ++i)
+		if (!v[i].is(tau::typed) && !v[i].is(tau::member_path))
+			CONCRETE_REJECT(var_class::rejected);
+	const auto& head = v[0];
+	if (head.is(tau::var_name))
+		return allow_io ? var_class::rejected : var_class::output;
+	if (!allow_io || !head.is(tau::io_var)) CONCRETE_REJECT(var_class::rejected);
+	if (head.children_size() != 2 || !head[0].is(tau::var_name)
+		|| !head[1].is(tau::offset)) CONCRETE_REJECT(var_class::rejected);
+	const auto& offset = head[1];
+	if (offset.children_size() != 1 || !offset[0].is(tau::variable))
+		CONCRETE_REJECT(var_class::rejected);
+	const auto& time = offset[0];
+	if (!time.children_size() || !time[0].is(tau::var_name)
+		|| !only_typed_after<node>(time.get(), 1)
+		|| time[0].get_string() != "t") CONCRETE_REJECT(var_class::rejected);
+	const size_t direction = head.data();
+	return direction == 1 ? var_class::input
+		: direction == 2 ? var_class::output : var_class::rejected;
+}
+
+// Type-independent name of a variable node: the stream or variable name,
+// `[t]` for a current io stream, then the flattened member path.
+template <NodeType node>
+std::string canonical_variable_name(tref var) {
+	using tau = tree<node>;
+	const auto& v = tau::get(var);
+	std::string name;
+	const auto& head = v[0];
+	if (head.is(tau::io_var)) name = head[0].get_string() + "[t]";
+	else name = head.get_string();
+	for (size_t i = 1; i < v.children_size(); ++i)
+		if (v[i].is(tau::member_path))
+			for (size_t j = 0; j < v[i].children_size(); ++j)
+				name += "." + v[i][j].get_string();
+	return name;
+}
+
+// Structural equality of two formulas or terms over the admitted fragment:
+// same node kinds and arity (type annotations ignored), same constants
+// (id and type), same canonical variable names, same effective BA type of
+// every `bf`.  Two such trees denote the same function, whatever their
+// interning history.
+template <NodeType node>
+bool same_structure(tref x, tref y) {
+	using tau = tree<node>;
+	if (x == y) return true;
+	const auto& a = tau::get(x);
+	const auto& b = tau::get(y);
+	if (a.value.nt != b.value.nt) return false;
+	if (a.is(tau::ba_constant))
+		return a.get_ba_constant_id() == b.get_ba_constant_id()
+			&& a.get_ba_type() == b.get_ba_type();
+	if (a.is(tau::variable))
+		return canonical_variable_name<node>(x)
+			== canonical_variable_name<node>(y);
+	if (a.is(tau::bf) && get_effective_ba_type<node>(x)
+		!= get_effective_ba_type<node>(y)) return false;
+	if (!a.children_size() && !b.children_size())
+		return a.is(tau::wff_t) || a.is(tau::wff_f) || a.is(tau::bf_t)
+			|| a.is(tau::bf_f) || a.to_str() == b.to_str();
+	std::vector<tref> ca, cb;
+	for (size_t i = 0; i < a.children_size(); ++i)
+		if (!a[i].is(tau::typed)) ca.push_back(a[i].get());
+	for (size_t i = 0; i < b.children_size(); ++i)
+		if (!b[i].is(tau::typed)) cb.push_back(b[i].get());
+	if (ca.size() != cb.size()) return false;
+	for (size_t i = 0; i < ca.size(); ++i)
+		if (!same_structure<node>(ca[i], cb[i])) return false;
+	return true;
+}
+
+// Matches a conditional `G ? A : B` as the node itself or as one of the
+// two desugarings the normal forms produce, `(!G || A) && (G || B)` and
+// `(G && A) || (!G && B)`, by guard identity (interned subtrees).
+template <NodeType node>
+bool match_conditional(tref n, tref& g, tref& a, tref& b) {
+	using tau = tree<node>;
+	const auto& w = tau::get(n);
+	if (!w.is(tau::wff) || w.children_size() != 1) return false;
+	const auto& op = w[0];
+	if (op.is(tau::wff_conditional) && op.children_size() == 3) {
+		g = op[0].get(), a = op[1].get(), b = op[2].get();
+		return true;
+	}
+	auto binary = [&](const tau& x, size_t kind, tref& l, tref& r) {
+		if (!x.is(tau::wff) || x.children_size() != 1 || !x[0].is(kind)
+			|| x[0].children_size() != 2) return false;
+		l = x[0][0].get(), r = x[0][1].get();
+		return true;
+	};
+	auto negation_of = [&](tref x, tref y) {   // x == !y
+		const auto& t = tau::get(x);
+		if (!(t.is(tau::wff) && t.children_size() == 1
+			&& t[0].is(tau::wff_neg) && t[0].children_size() == 1))
+			return false;
+		if (same_structure<node>(t[0][0].get(), y)) return true;
+		if (const char* trace = std::getenv("TAU_CONCRETE_EVAL_TRACE");
+			trace && std::string_view(trace) == "1")
+			std::cerr << "concrete_eval: guard mismatch\n  neg: "
+				<< tau::get(t[0][0].get()).to_str().substr(0, 300)
+				<< "\n  pos: " << tau::get(y).to_str().substr(0, 300) << "\n";
+		return false;
+	};
+	tref l = nullptr, r = nullptr;
+	if (op.is(tau::wff_and) && op.children_size() == 2) {
+		tref l1, l2, r1, r2;
+		// (G -> A) && (!G -> B), either order: what build_wff_conditional
+		// constructs
+		if (binary(w[0][0], tau::wff_imply, l1, l2)
+			&& binary(w[0][1], tau::wff_imply, r1, r2))
+		{
+			for (int swap = 0; swap < 2; ++swap) {
+				tref gg = swap ? r1 : l1, aa = swap ? r2 : l2;
+				tref ng = swap ? l1 : r1, bb = swap ? l2 : r2;
+				if (negation_of(ng, gg)) { g = gg, a = aa, b = bb; return true; }
+			}
+			return false;
+		}
+		// (!G || A) && (G || B), either order
+		if (!binary(w[0][0], tau::wff_or, l1, l2)
+			|| !binary(w[0][1], tau::wff_or, r1, r2)) return false;
+		for (int swap = 0; swap < 2; ++swap) {
+			tref ng = swap ? r1 : l1, aa = swap ? r2 : l2;
+			tref gg = swap ? l1 : r1, bb = swap ? l2 : r2;
+			if (negation_of(ng, gg)) { g = gg, a = aa, b = bb; return true; }
+		}
+		return false;
+	}
+	if (op.is(tau::wff_or) && op.children_size() == 2) {
+		// (G && A) || (!G && B), either order
+		tref l1, l2, r1, r2;
+		if (!binary(w[0][0], tau::wff_and, l1, l2)
+			|| !binary(w[0][1], tau::wff_and, r1, r2)) return false;
+		for (int swap = 0; swap < 2; ++swap) {
+			tref gg = swap ? r1 : l1, aa = swap ? r2 : l2;
+			tref ng = swap ? l1 : r1, bb = swap ? l2 : r2;
+			if (negation_of(ng, gg)) { g = gg, a = aa, b = bb; return true; }
+		}
+		return false;
+	}
+	(void) l; (void) r;
+	return false;
+}
+
+// Diagnostics: node kinds of the first levels of @p n.
+template <NodeType node>
+void dump_shape(std::ostream& os, tref n, size_t depth, size_t max_depth) {
+	using tau = tree<node>;
+	const auto& t = tau::get(n);
+	os << std::string(depth * 2, ' ') << node::name(t.value.nt)
+		<< " (" << t.children_size() << ")";
+	if (!t.children_size()) os << " " << t.to_str();
+	os << "\n";
+	if (depth < max_depth)
+		for (size_t i = 0; i < t.children_size() && i < 4; ++i)
+			dump_shape<node>(os, t[i].get(), depth + 1, max_depth);
+}
+
+struct concrete_scan {
+	bool allow_io = false;
+	std::vector<std::pair<tref, tref>> vars;   // (variable, its bf) met by the walk
+	size_t count = 0;
+	size_t limit = 0;   // occurrences this scan may still admit
+	// Counts one occurrence; false (over budget) once the limit is spent.
+	bool tick() {
+		if (count >= limit) return concrete_reject_over_budget = true, false;
+		return ++count, true;
+	}
+};
+
+template <NodeType node>
+bool admit_concrete_term(tref term, concrete_scan& s) {
+	using tau = tree<node>;
+	const auto& wrapper = tau::get(term);
+	if (!wrapper.is(tau::bf) || !wrapper.children_size()
+		|| !only_typed_after<node>(term, 1)) CONCRETE_REJECT(false);
+	if (family_of<node>(term) != type_family::bv) CONCRETE_REJECT(false);
+	if (!s.tick()) CONCRETE_REJECT(false);
+	const size_t type = get_effective_ba_type<node>(term);
+	tref inner_ref = wrapper[0].get();
+	const auto& inner = tau::get(inner_ref);
+	if (inner.is(tau::variable)) {
+		if (classify_variable<node>(inner_ref, s.allow_io)
+			== var_class::rejected) CONCRETE_REJECT(false);
+		s.vars.push_back({inner_ref, term});
+		return true;
+	}
+	if (inner.is(tau::ba_constant)) return inner.get_ba_constant_id() != 0;
+	if (inner.is(tau::bf_t) || inner.is(tau::bf_f)) return true;
+	if (inner.is(tau::bf_neg)) {
+		if (inner.children_size() != 1) CONCRETE_REJECT(false);
+		tref operand = inner[0].get();
+		return get_effective_ba_type<node>(operand) == type
+			&& admit_concrete_term<node>(operand, s);
+	}
+	if (inner.is(tau::bf_and) || inner.is(tau::bf_or) || inner.is(tau::bf_xor)
+		|| inner.is(tau::bf_add) || inner.is(tau::bf_sub)
+		|| inner.is(tau::bf_mul) || inner.is(tau::bf_div)
+		|| inner.is(tau::bf_mod) || inner.is(tau::bf_shl)
+		|| inner.is(tau::bf_shr) || inner.is(tau::bf_min)
+		|| inner.is(tau::bf_max) || inner.is(tau::bf_nand)
+		|| inner.is(tau::bf_nor) || inner.is(tau::bf_xnor))
+	{
+		if (inner.children_size() != 2) CONCRETE_REJECT(false);
+		tref left = inner[0].get(), right = inner[1].get();
+		return get_effective_ba_type<node>(left) == type
+			&& get_effective_ba_type<node>(right) == type
+			&& admit_concrete_term<node>(left, s)
+			&& admit_concrete_term<node>(right, s);
+	}
+	CONCRETE_REJECT(false);
+}
+
+template <NodeType node>
+bool admit_concrete_wff(tref formula, concrete_scan& s) {
+	using tau = tree<node>;
+	const auto& wrapper = tau::get(formula);
+	if (!wrapper.is(tau::wff) || wrapper.children_size() != 1) CONCRETE_REJECT(false);
+	if (!s.tick()) CONCRETE_REJECT(false);
+	const auto& op = wrapper[0];
+	if (op.is(tau::wff_t) || op.is(tau::wff_f)) return op.children_size() == 0;
+	if (op.is(tau::wff_neg))
+		return op.children_size() == 1
+			&& admit_concrete_wff<node>(op[0].get(), s);
+	if (op.is(tau::wff_conditional))
+		return op.children_size() == 3
+			&& admit_concrete_wff<node>(op[0].get(), s)
+			&& admit_concrete_wff<node>(op[1].get(), s)
+			&& admit_concrete_wff<node>(op[2].get(), s);
+	if (op.is(tau::wff_and) || op.is(tau::wff_or) || op.is(tau::wff_imply)
+		|| op.is(tau::wff_equiv) || op.is(tau::wff_xor))
+		return op.children_size() == 2
+			&& admit_concrete_wff<node>(op[0].get(), s)
+			&& admit_concrete_wff<node>(op[1].get(), s);
+	if (op.is(tau::bf_eq) || op.is(tau::bf_neq)
+		|| op.is(tau::bf_lt) || op.is(tau::bf_nlt)
+		|| op.is(tau::bf_lteq) || op.is(tau::bf_nlteq)
+		|| op.is(tau::bf_gt) || op.is(tau::bf_ngt)
+		|| op.is(tau::bf_gteq) || op.is(tau::bf_ngteq))
+	{
+		if (op.children_size() != 2) CONCRETE_REJECT(false);
+		tref left = op[0].get(), right = op[1].get();
+		if (family_of<node>(left) != type_family::bv
+			|| get_effective_ba_type<node>(left)
+				!= get_effective_ba_type<node>(right)) CONCRETE_REJECT(false);
+		return admit_concrete_term<node>(left, s)
+			&& admit_concrete_term<node>(right, s);
+	}
+	CONCRETE_REJECT(false);
+}
+
+template <NodeType node>
+void flatten_conjunction(tref formula, trefs& clauses) {
+	using tau = tree<node>;
+	const auto& w = tau::get(formula);
+	if (w.is(tau::wff) && w.children_size() == 1 && w[0].is(tau::wff_and)
+		&& w[0].children_size() == 2)
+	{
+		flatten_conjunction<node>(w[0][0].get(), clauses);
+		flatten_conjunction<node>(w[0][1].get(), clauses);
+	} else clauses.push_back(formula);
+}
+
+} // namespace concrete_definition_detail
+
+// `max_expressions` is the admission budget: the most wff/bf occurrences
+// the definition may hold (guards and leaf terms together); one more is a
+// rejection with concrete_reject_over_budget set.
+template <NodeType node>
+std::optional<concrete_definition<node>>
+recognize_concrete_definition(tref formula, bool allow_io,
+	size_t max_expressions)
+{
+	using tau = tree<node>;
+	using namespace concrete_definition_detail;
+	concrete_reject_line = 0;
+	concrete_reject_over_budget = false;
+	auto remaining = [&](concrete_definition<node>& d) {
+		return max_expressions > d.expression_count
+			? max_expressions - d.expression_count : 0;
+	};
+	if (!formula) CONCRETE_REJECT(std::nullopt);
+	const auto& root = tau::get(formula);
+	if (!root.is(tau::wff) || root.children_size() != 1) CONCRETE_REJECT(std::nullopt);
+	tref body = formula;
+	if (root[0].is(tau::wff_always)) {
+		if (!allow_io || root[0].children_size() != 1) CONCRETE_REJECT(std::nullopt);
+		body = root[0][0].get();
+	}
+	concrete_definition<node> def;
+	std::unordered_map<std::string, size_t> input_slot, output_slot;
+	std::unordered_map<tref, size_t> input_seen, output_seen;
+	auto register_var = [&](tref var, tref wrapper, var_class cls) -> bool {
+		auto& slots = cls == var_class::input ? input_slot : output_slot;
+		auto& seen = cls == var_class::input ? input_seen : output_seen;
+		auto& refs = cls == var_class::input ? def.inputs : def.outputs;
+		auto& names = cls == var_class::input ? def.input_names
+							: def.output_names;
+		auto& types = cls == var_class::input ? def.input_types
+							: def.output_types;
+		const size_t type = get_effective_ba_type<node>(wrapper);
+		if (auto it = seen.find(var); it != seen.end())
+			return types[refs[it->second].slot] == type;
+		const std::string name = canonical_variable_name<node>(var);
+		size_t slot;
+		if (auto it = slots.find(name); it != slots.end()) {
+			slot = it->second;
+			if (types[slot] != type) CONCRETE_REJECT(false);
+		} else {
+			slot = names.size();
+			slots.emplace(name, slot);
+			names.push_back(name);
+			types.push_back(type);
+		}
+		seen.emplace(var, refs.size());
+		refs.push_back({var, slot});
+		return true;
+	};
+	std::function<std::optional<size_t>(tref)> visit;
+	std::unordered_map<tref, size_t> visited;
+	visit = [&](tref n) -> std::optional<size_t> {
+		if (auto it = visited.find(n); it != visited.end())
+			return it->second;
+		const auto& w = tau::get(n);
+		if (!w.is(tau::wff) || w.children_size() != 1) CONCRETE_REJECT(std::nullopt);
+		tref guard = nullptr, yes_branch = nullptr, no_branch = nullptr;
+		if (match_conditional<node>(n, guard, yes_branch, no_branch)) {
+			concrete_scan s{allow_io};
+			s.limit = remaining(def);
+			if (!admit_concrete_wff<node>(guard, s)) CONCRETE_REJECT(std::nullopt);
+			def.expression_count += s.count;
+			for (auto [var, wrapper] : s.vars) {
+				if (classify_variable<node>(var, allow_io)
+					!= var_class::input) CONCRETE_REJECT(std::nullopt);
+				if (!register_var(var, wrapper, var_class::input))
+					CONCRETE_REJECT(std::nullopt);
+			}
+			const size_t id = def.nodes.size();
+			def.nodes.push_back({false, def.branches.size()});
+			def.branches.push_back({guard, 0, 0});
+			auto yes = visit(yes_branch);
+			if (!yes) CONCRETE_REJECT(std::nullopt);
+			auto no = visit(no_branch);
+			if (!no) CONCRETE_REJECT(std::nullopt);
+			def.branches[def.nodes[id].index].yes = *yes;
+			def.branches[def.nodes[id].index].no = *no;
+			visited.emplace(n, id);
+			return id;
+		}
+		// a leaf: a conjunction of output definitions
+		trefs clauses;
+		flatten_conjunction<node>(n, clauses);
+		const bool first_leaf = def.leaves.empty();
+		typename concrete_definition<node>::leaf leaf;
+		const size_t known = def.output_names.size();
+		std::vector<std::vector<size_t>> deps;
+		std::vector<size_t> slots;
+		for (tref clause : clauses) {
+			const auto& c = tau::get(clause);
+			if (!c.is(tau::wff) || c.children_size() != 1
+				|| !c[0].is(tau::bf_eq) || c[0].children_size() != 2)
+				CONCRETE_REJECT(std::nullopt);
+			tref lhs = c[0][0].get(), rhs = c[0][1].get();
+			const auto& lw = tau::get(lhs);
+			if (!lw.is(tau::bf) || !lw.children_size()
+				|| !only_typed_after<node>(lhs, 1)
+				|| !lw[0].is(tau::variable)
+				|| family_of<node>(lhs) != type_family::bv
+				|| get_effective_ba_type<node>(lhs)
+					!= get_effective_ba_type<node>(rhs)) CONCRETE_REJECT(std::nullopt);
+			tref var = lw[0].get();
+			if (classify_variable<node>(var, allow_io) != var_class::output)
+				CONCRETE_REJECT(std::nullopt);
+			if (!first_leaf && !output_slot.count(canonical_variable_name<node>(var)))
+				CONCRETE_REJECT(std::nullopt);
+			if (!register_var(var, lhs, var_class::output)) CONCRETE_REJECT(std::nullopt);
+			const size_t slot = output_slot.at(canonical_variable_name<node>(var));
+			if (std::find(slots.begin(), slots.end(), slot) != slots.end())
+				CONCRETE_REJECT(std::nullopt);   // defined twice
+			concrete_scan s{allow_io};
+			s.limit = remaining(def);
+			if (!s.tick() || !admit_concrete_term<node>(rhs, s))
+				CONCRETE_REJECT(std::nullopt);
+			def.expression_count += s.count;
+			std::vector<size_t> d;
+			for (auto [v, wrapper] : s.vars) {
+				const var_class cls = classify_variable<node>(v, allow_io);
+				if (cls == var_class::rejected
+					|| !register_var(v, wrapper, cls)) CONCRETE_REJECT(std::nullopt);
+				if (cls == var_class::output)
+					d.push_back(output_slot.at(canonical_variable_name<node>(v)));
+			}
+			slots.push_back(slot);
+			deps.push_back(std::move(d));
+			leaf.terms.push_back(rhs);
+			leaf.lhs.push_back(lhs);
+		}
+		// every leaf defines exactly the output set of the first leaf
+		if (first_leaf ? slots.size() != def.output_names.size()
+			: (slots.size() != known || def.output_names.size() != known))
+			CONCRETE_REJECT(std::nullopt);
+		if (slots.empty()) CONCRETE_REJECT(std::nullopt);
+		// reorder to slot order and check the dependency order is acyclic
+		typename concrete_definition<node>::leaf ordered;
+		ordered.terms.assign(slots.size(), nullptr);
+		ordered.lhs.assign(slots.size(), nullptr);
+		std::vector<std::vector<size_t>> by_slot(slots.size());
+		for (size_t i = 0; i < slots.size(); ++i) {
+			ordered.terms[slots[i]] = leaf.terms[i];
+			ordered.lhs[slots[i]] = leaf.lhs[i];
+			by_slot[slots[i]] = deps[i];
+		}
+		std::vector<bool> done(slots.size(), false);
+		for (size_t round = 0; round < slots.size(); ++round) {
+			bool progress = false;
+			for (size_t k = 0; k < slots.size(); ++k) {
+				if (done[k]) continue;
+				bool ready = true;
+				for (size_t dep : by_slot[k])
+					if (dep >= slots.size() || !done[dep]) ready = false;
+				if (!ready) continue;
+				done[k] = true, progress = true;
+				ordered.order.push_back(k);
+			}
+			if (!progress) break;
+		}
+		if (ordered.order.size() != slots.size()) CONCRETE_REJECT(std::nullopt);
+		const size_t id = def.nodes.size();
+		def.nodes.push_back({true, def.leaves.size()});
+		def.leaves.push_back(std::move(ordered));
+		visited.emplace(n, id);
+		return id;
+	};
+	if (!visit(body) || def.nodes.empty()) {
+		if (const char* trace = std::getenv("TAU_CONCRETE_EVAL_TRACE");
+			trace && std::string_view(trace) == "1")
+		{
+			std::cerr << "concrete_eval: rejected at line "
+				<< concrete_reject_line << "; body shape:\n";
+			dump_shape<node>(std::cerr, body, 0, 5);
+		}
+		CONCRETE_REJECT(std::nullopt);
+	}
+	return def;
+}
+
+} // namespace idni::tau_lang
+
+#endif // __IDNI__TAU__CONCRETE_DEFINITION_H__
diff --git a/src/heuristics/concrete_eval.h b/src/heuristics/concrete_eval.h
new file mode 100644
index 00000000..025d613c
--- /dev/null
+++ b/src/heuristics/concrete_eval.h
@@ -0,0 +1,181 @@
+// To view the license please visit https://github.com/IDNI/tau-lang/blob/main/LICENSE.md
+
+#ifndef __IDNI__TAU__CONCRETE_EVAL_H__
+#define __IDNI__TAU__CONCRETE_EVAL_H__
+
+// Opt-in (TAU_CONCRETE_EVAL=1) evaluation of an admitted concrete
+// conditional definition (recognize_concrete_definition) under a concrete
+// input valuation.  This header is pack-independent: it holds the switches,
+// the admission budget, the strict decimal reader and the evaluator
+// interface.  The evaluation itself is a BA capability
+// (ba_descriptor<BA, node>::concrete_evaluator, ba_has_concrete_evaluator):
+// build_concrete_evaluator asks the pack's BAs in order and declines when
+// none offers one, so a pack without such a BA (e.g. -DTAU_BAS=sbf,tau,qint)
+// builds and answers every request with a clean decline.  The bv backend
+// lives in boolean_algebras/bv/heuristics/bv_concrete_eval.h.
+//
+// Related upstream work evaluates a functional step inside `run`
+// (IDNI/tau-lang #178, #179); this path is separate, opt-in, and retains an
+// admitted evaluator across REPL calls (`evalspec`).
+
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "boolean_algebras/ba_descriptor.h"
+#include "boolean_algebras/ba_pack_traits.h"
+#include "env_limits.h"
+#include "heuristics/memory_telemetry.h"
+#include "heuristics/concrete_definition.h"
+
+namespace idni::tau_lang {
+
+inline bool concrete_eval_enabled() {
+	const char* value = std::getenv("TAU_CONCRETE_EVAL");
+	return value && std::string_view(value) == "1";
+}
+
+// TAU_CONCRETE_EVAL_TRACE=1: one stderr line per admission or decline.
+inline bool concrete_eval_trace() {
+	const char* value = std::getenv("TAU_CONCRETE_EVAL_TRACE");
+	return value && std::string_view(value) == "1";
+}
+
+// Admission budget: the most wff/bf occurrences the recognizer may admit
+// for one definition (TAU_CONCRETE_EVAL_MAX_EXPRESSIONS, default 2^20).
+// Over budget is a decline, never a verdict.  The retained evaluator holds
+// at most one backend term per admitted occurrence plus one per leaf, so
+// this also bounds the evaluator's size.
+inline size_t concrete_eval_max_expressions() {
+	return env_limit_count("TAU_CONCRETE_EVAL_MAX_EXPRESSIONS",
+		size_t{1} << 20);
+}
+
+// 2^width as decimal text (schoolbook doubling; width is a bit-width).
+inline std::string decimal_pow2(size_t width) {
+	std::string digits = "1";   // least significant digit first
+	for (size_t i = 0; i < width; ++i) {
+		int carry = 0;
+		for (char& d : digits) {
+			const int v = (d - '0') * 2 + carry;
+			d = char('0' + v % 10), carry = v / 10;
+		}
+		if (carry) digits.push_back(char('0' + carry));
+	}
+	return std::string(digits.rbegin(), digits.rend());
+}
+
+// Strict unsigned decimal of a `width`-bit value: digits only, no sign, no
+// leading zero (except "0" itself), and below 2^width (`pow2` is
+// decimal_pow2(width)).  Nothing else is accepted: text that fails here is
+// a bad input, not a value.
+inline bool strict_unsigned_decimal(std::string_view text,
+	const std::string& pow2)
+{
+	if (text.empty() || text.size() > pow2.size()) return false;
+	for (char c : text) if (c < '0' || c > '9') return false;
+	if (text.size() > 1 && text[0] == '0') return false;
+	if (text.size() < pow2.size()) return true;
+	return text < std::string_view(pow2);
+}
+
+// The evaluator a backend hands back: the admitted definition plus the
+// evaluation of one valuation.  Values cross this boundary as canonical
+// decimal text and as Tau constant nodes, so core never names a backend's
+// value type.
+template <NodeType node>
+struct concrete_evaluator_iface {
+	using tau = tree<node>;
+	struct outcome {
+		size_t leaf = 0;
+		std::vector<std::string> decimals;   // per output slot
+		std::vector<tref> constants;         // `{ v }:T` per output slot
+	};
+	concrete_definition<node> def;
+	htref pin;                          // keeps the admitted formula alive
+	std::vector<size_t> input_widths;   // bits per input slot
+	std::vector<size_t> output_widths;  // bits per output slot
+	size_t retained_terms = 0;          // backend terms held (size report)
+	std::vector<std::string> input_pow2; // decimal_pow2 per input slot (lazy)
+
+	virtual ~concrete_evaluator_iface() = default;
+
+	// `values[i]` is strict decimal text (see check_input) of input slot i;
+	// nullopt when the backend cannot evaluate the valuation.
+	virtual std::optional<outcome> evaluate(
+		const std::vector<std::string>& values,
+		bool materialize_constants = true) const = 0;
+
+	// Whether `text` is a strict decimal of input slot i's width.
+	bool check_input(size_t i, std::string_view text) {
+		if (input_pow2.size() != input_widths.size()) {
+			input_pow2.clear();
+			for (size_t w : input_widths)
+				input_pow2.push_back(decimal_pow2(w));
+		}
+		return i < input_pow2.size()
+			&& strict_unsigned_decimal(text, input_pow2[i]);
+	}
+};
+
+template <typename Node, typename BA>
+concept ba_has_concrete_evaluator = ba_has_descriptor_v<Node, BA>
+	&& requires(tref f, bool allow_io, size_t budget) {
+		{ ba_descriptor<BA, Node>::concrete_evaluator(f, allow_io, budget) }
+			-> std::convertible_to<
+				std::shared_ptr<concrete_evaluator_iface<Node>>>; };
+
+/** @brief Whether any BA of @p Node's pack offers a concrete evaluator. */
+template <typename Node>
+constexpr bool pack_has_concrete_evaluator() {
+	return []<std::size_t... Is>(std::index_sequence<Is...>) {
+		return (false || ... || ba_has_concrete_evaluator<Node,
+			std::tuple_element_t<Is, typename Node::bas_tuple>>);
+	}(std::make_index_sequence<std::tuple_size_v<typename Node::bas_tuple>>{});
+}
+
+// Builds the evaluator of @p formula with the first BA of the pack that
+// offers one.  `reason` names the decline: "no_backend" when the pack has
+// no evaluating BA, "over_budget" when the recognizer stopped at the
+// admission budget, "not_admissible" (with concrete_reject_line) otherwise.
+// A backend exception is a decline ("exception"), never an answer.
+template <NodeType node>
+std::shared_ptr<concrete_evaluator_iface<node>> build_concrete_evaluator(
+	tref formula, bool allow_io, std::string& reason)
+{
+	std::shared_ptr<concrete_evaluator_iface<node>> ev;
+	reason = "no_backend";
+	if constexpr (!pack_has_concrete_evaluator<node>()) return ev;
+	else {
+		const size_t budget = concrete_eval_max_expressions();
+		bool tried = false;
+		pack_visit_all<node>([&]<typename BA>() {
+			if constexpr (ba_has_concrete_evaluator<node, BA>) {
+				if (tried) return;
+				tried = true;
+				try {
+					ev = ba_descriptor<BA, node>::concrete_evaluator(
+						formula, allow_io, budget);
+					reason = ev ? "admitted"
+						: concrete_reject_over_budget ? "over_budget"
+						: "not_admissible";
+				} catch (const std::exception& e) {
+					ev.reset();
+					reason = "exception";
+					if (concrete_eval_trace()) std::cerr
+						<< "concrete_eval: declined by exception: "
+						<< e.what() << "\n";
+				}
+			}
+		});
+		return ev;
+	}
+}
+
+} // namespace idni::tau_lang
+
+#endif // __IDNI__TAU__CONCRETE_EVAL_H__
