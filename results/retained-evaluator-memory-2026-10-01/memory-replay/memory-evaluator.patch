 }
 
+
+template <typename... BAs>
+requires BAsPack<BAs...>
+void repl_evaluator<BAs...>::evalspec_line(const std::string& args) {
+	std::vector<std::string> tokens;
+	for (size_t i = 0; i < args.size();) {
+		while (i < args.size() && std::isspace((unsigned char) args[i])) ++i;
+		size_t j = i;
+		while (j < args.size() && !std::isspace((unsigned char) args[j])) ++j;
+		if (j > i) tokens.push_back(args.substr(i, j - i));
+		i = j;
+	}
+	// a command terminator is tolerated
+	if (!tokens.empty() && tokens.back() == ".") tokens.pop_back();
+	if (!tokens.empty() && tokens.back().size() > 1
+		&& tokens.back().back() == '.') tokens.back().pop_back();
+	// Response frame: one `evalspec-result:` line of name=value pairs,
+	// then `evalspec-end`.  A failure is status=error with a reason token
+	// on the frame and the message on err; it never carries a verdict.
+	auto frame = [&](const std::string& fields) {
+		out << "evalspec-result: " << fields << "\nevalspec-end\n";
+	};
+	auto fail = [&](const std::string& reason, const std::string& msg) {
+		err << "evalspec error: " << msg << "\n";
+		error = true;
+		frame("status=error reason=" + reason);
+	};
+	// %N: decimal digits only, no leading zero; a location longer than any
+	// history could be is not an index either
+	if (tokens.empty() || tokens[0].size() < 2 || tokens[0][0] != '%'
+		|| tokens[0].find_first_not_of("0123456789", 1) != std::string::npos)
+		return fail("usage", "usage: evalspec %N [value ...]");
+	size_t n = 0;
+	if (tokens[0].size() <= 10 && tokens[0][1] != '0')
+		for (size_t i = 1; i < tokens[0].size(); ++i)
+			n = n * 10 + size_t(tokens[0][i] - '0');
+	if (n == 0 || n > H.size())
+		return fail("bad_history", "history location does not exist");
+	tref entry = H[n - 1]->get();
+	// An admitted evaluator has the definitions of its admission unfolded
+	// into it; the definition and stream lists only grow (reset clears them
+	// with the cache), so a change in their sizes retires the cache.
+	const size_t defs_seen = type_defs.size() + rr_defs.size() + io_defs.size();
+	if (defs_seen != concrete_cache_defs) {
+		concrete_cache.clear();
+		concrete_cache_defs = defs_seen;
+	}
+	std::shared_ptr<concrete_evaluator_iface<node>> ev;
+	bool newly_admitted = false;
+	if (auto it = concrete_cache.find(entry); it != concrete_cache.end())
+		ev = it->second;
+	else {
+		// The spec is assembled as run_cmd assembles it for `run %N`.
+		emit_memory_telemetry("before_admission", ba_constants<node>::pool_entries(), out, tau::m_size());
+		tau_spec<node> spec;
+		spec.add(get_spec_as_written(entry));
+		for (const htref& d : rr_defs) spec.add(d->get());
+		for (const htref& d : io_defs) spec.add(d->get());
+		std::string reason;
+		ev = tau_api::admit_concrete_evaluator(spec, reason);
+		if (!ev) {
+			if (reason == "no_backend") return fail(reason,
+				"no BA of this pack offers a concrete evaluator");
+			if (reason == "over_budget") return fail(reason,
+				"admission budget of "
+				+ std::to_string(concrete_eval_max_expressions())
+				+ " expressions exceeded (TAU_CONCRETE_EVAL_MAX_EXPRESSIONS)");
+			if (reason == "not_admissible" || reason == "exception")
+				return fail(reason,
+					"not an admissible concrete conditional definition (reject at line "
+					+ std::to_string(concrete_reject_line) + ")");
+			return fail(reason, "admission failed: " + reason);
+		}
+		if (concrete_eval_trace()) std::cerr
+			<< "concrete_eval: evalspec admitted, leaves="
+			<< ev->def.leaves.size() << " decisions="
+			<< ev->def.branches.size() << " inputs="
+			<< ev->def.input_names.size() << " outputs="
+			<< ev->def.output_names.size() << "\n";
+		concrete_cache.emplace(entry, ev);
+		emit_memory_telemetry("after_admission", ba_constants<node>::pool_entries(), out, tau::m_size());
+		newly_admitted = true;
+	}
+	if (newly_admitted) {
+		// The load's owned parser result and this admission's local spec are
+		// gone. Direct evalspec commands otherwise leave the last large chart
+		// resident indefinitely. Embedded/concurrent owners remain excluded.
+		if (opt.standalone_memory_cleanup && !running && !pending
+			&& memory_switch("TAU_EVAL_RELEASE_PARSE_SCRATCH")
+			&& tau_parser::instance().release_parse_scratch())
+			++memory_counts.parse_scratch_releases;
+		emit_memory_telemetry("after_parse_scratch_release", ba_constants<node>::pool_entries(), out, tau::m_size());
+		reclaim_free_allocator_pages();
+		emit_memory_telemetry("after_reclaim", ba_constants<node>::pool_entries(), out, tau::m_size());
+	}
+	const auto& def = ev->def;
+	if (tokens.size() == 1) {
+		// Cached admission is also a read-only checkpoint; no parser call,
+		// evaluation, second trim or scratch release is performed here.
+		emit_memory_telemetry("checkpoint", ba_constants<node>::pool_entries(), out, tau::m_size());
+		out << "inputs:";
+		for (const auto& name : def.input_names) out << " " << name;
+		out << "\noutputs:";
+		for (const auto& name : def.output_names) out << " " << name;
+		out << "\ndecisions: " << def.branches.size()
+			<< " leaves: " << def.leaves.size()
+			<< " expressions: " << def.expression_count << "\n";
+		frame("status=admitted inputs=" + std::to_string(def.input_names.size())
+			+ " outputs=" + std::to_string(def.output_names.size())
+			+ " decisions=" + std::to_string(def.branches.size())
+			+ " leaves=" + std::to_string(def.leaves.size())
+			+ " expressions=" + std::to_string(def.expression_count)
+			+ " retained_terms=" + std::to_string(ev->retained_terms)
+			+ " budget=" + std::to_string(concrete_eval_max_expressions()));
+		return;
+	}
+	if (tokens.size() - 1 != def.input_names.size())
+		return fail("arity", "expected " + std::to_string(def.input_names.size())
+			+ " input values, got " + std::to_string(tokens.size() - 1));
+	std::vector<std::string> values;
+	for (size_t i = 1; i < tokens.size(); ++i) {
+		if (!ev->check_input(i - 1, tokens[i]))
+			return fail("bad_value", "input value " + std::to_string(i)
+				+ " is not a strict unsigned decimal below 2^"
+				+ std::to_string(ev->input_widths[i - 1]) + " ("
+				+ def.input_names[i - 1] + ")");
+		values.push_back(tokens[i]);
+	}
+	std::optional<typename concrete_evaluator_iface<node>::outcome> outcome;
+	try { outcome = ev->evaluate(values, !memory_switch("TAU_EVAL_DECIMAL_ONLY")); }
+	catch (const std::exception& e) {
+		return fail("evaluation_exception",
+			std::string("evaluation failed by exception: ") + e.what());
+	}
+	if (!outcome) return fail("evaluation_failed", "evaluation failed");
+	emit_memory_telemetry("after_evaluation", ba_constants<node>::pool_entries(), out, tau::m_size());
+	std::string fields = "status=ok leaf=" + std::to_string(outcome->leaf)
+		+ " outputs=" + std::to_string(outcome->decimals.size());
+	for (size_t k = 0; k < outcome->decimals.size(); ++k)
+		fields += " " + def.output_names[k] + "=" + outcome->decimals[k];
+	frame(fields);
+}
