+TEST_CASE("parser scratch release preserves lazy results and subsequent parses") {
+	auto& p = tau_parser::instance();
+	const auto* grammar = &p.get_grammar();
+	auto first = p.parse("version", 7, { .start = tau_parser::cli });
+	REQUIRE(first.found);
+	CHECK(p.release_parse_scratch());
+	CHECK(p.release_parse_scratch());
+	// Materialize the earlier result only after release: it owns its root.
+	CHECK(first.get_shaped_tree2() != nullptr);
+	auto second = p.parse("get charvar", 11, { .start = tau_parser::cli });
+	REQUIRE(second.found);
+	CHECK(p.release_parse_scratch());
+	CHECK(second.get_shaped_tree2() != nullptr);
+	CHECK(first.get_shaped_tree2() != nullptr);
+	CHECK(&p.get_grammar() == grammar);
+	tau_dynamic_context names;
+	const std::string declaration = "type MemoryProbe = {x: bool}. T.";
+	auto declared = p.parse(declaration.data(), declaration.size(),
+		{ .start = tau_parser::spec_multiline, .dynamic_ctx = &names });
+	REQUIRE(declared.found);
+	const auto saved_names = names.values;
+	REQUIRE(!saved_names.empty());
+	CHECK(p.release_parse_scratch());
+	CHECK(names.values == saved_names);
+	const std::string use = "ex x:MemoryProbe x = 0.";
+	auto used = p.parse(use.data(), use.size(),
+		{ .start = tau_parser::spec_multiline, .dynamic_ctx = &names });
+	REQUIRE(used.found);
+	CHECK(p.release_parse_scratch());
+	CHECK(names.values == saved_names);
+	CHECK(declared.get_shaped_tree2() != nullptr);
+	CHECK(used.get_shaped_tree2() != nullptr);
+}
+
+TEST_CASE("parser scratch release refuses an active grow callback") {
+	idni::nonterminals<char> nts;
+	idni::prods<char> ps, start(nts("start")), parent(nts("parent")), child(nts("child"));
+	ps(start, parent);
+	ps(parent, child + "x");
+	ps(child, idni::prods<char>("a"));
+	idni::char_class_fns<char> character_classes;
+	idni::grammar<char> grammar(nts, ps, start, character_classes);
+	idni::parser<char>* active = nullptr;
+	bool callback_ran = false;
+	idni::parser<char>::options options;
+	options.dynamic_grow_nts = {{grammar.nt("parent").n(), grammar.nt("child").n()}};
+	options.on_dynamic_grow = [&](idni::parser<char>::input&, size_t, size_t, size_t) {
+		callback_ran = true;
+		CHECK_FALSE(active->release_parse_scratch());
+	};
+	idni::parser<char> local(grammar, options);
+	active = &local;
+	auto parsed = local.parse("ax", 2);
+	REQUIRE(parsed.found);
+	CHECK(callback_ran);
+	CHECK(local.release_parse_scratch());
+}
+
+namespace {
+
+struct env_guard {
+	env_guard(const char* name, const char* value) : name(name) {
+		if (const char* p = std::getenv(name)) had_value = true, saved = p;
+		if (value) setenv(name, value, 1); else unsetenv(name);
+	}
+	~env_guard() {
+		if (had_value) setenv(name, saved.c_str(), 1); else unsetenv(name);
+	}
+	const char* name;
+	bool had_value = false;
+	std::string saved;
+};
+
+std::string bvt(size_t w) { return ":bv[" + std::to_string(w) + "]"; }
+std::string cst(uint64_t v, size_t w) {
+	return "{" + std::to_string(v) + "}" + bvt(w);
+}
+uint64_t top(size_t w) { return (uint64_t{1} << w) - 1; }
+
+// The value text the string solve API renders for a bv constant: the
+// numeral `{ n }:bv[w]`, a bare numeral (the endpoints: `0`, and all ones
+// as e.g. `3` for bv[2]), or F/T.
+std::optional<uint64_t> read_value(const std::string& text, size_t w) {
+	const auto lb = text.find('{'), rb = text.find('}');
+	if (lb != std::string::npos && rb != std::string::npos && rb > lb) {
+		std::string digits;
+		for (size_t i = lb + 1; i < rb; ++i)
+			if (text[i] >= '0' && text[i] <= '9') digits += text[i];
+			else if (text[i] != ' ') return std::nullopt;
+		if (digits.empty()) return std::nullopt;
+		return std::stoull(digits);
+	}
+	std::string t;
+	for (char c : text) if (c != ' ' && c != '\t' && c != '\n') t += c;
+	if (t == "F") return uint64_t{0};
+	if (t == "T") return top(w);
+	if (t.empty() || t.size() > 19
+		|| t.find_first_not_of("0123456789") != std::string::npos)
+		return std::nullopt;
+	return std::stoull(t);
+}
+
+// Ordinary `solve` of a ground formula with the switch off: the oracle.
+// Returns the value of each variable named in `vars`.
+std::optional<std::vector<uint64_t>> oracle(const std::string& formula,
+	const std::vector<std::string>& vars, size_t w)
+{
+	env_guard off("TAU_CONCRETE_EVAL", nullptr);
+	auto r = tau_api::solve(formula, solver_mode::general);
+	if (!r.has_value()) return std::nullopt;
+	std::vector<uint64_t> out;
+	for (const auto& v : vars) {
+		std::optional<uint64_t> found;
+		for (const auto& [name, value] : r.value())
+			if (name == v || name.rfind(v + ":", 0) == 0)
+				found = read_value(value, w);
+		if (!found) return std::nullopt;
+		out.push_back(*found);
+	}
+	return out;
+}
+
+// The same ground formula solved with the switch on (solve's admitted
+// ground path) -- must agree with the oracle.
+std::optional<std::vector<uint64_t>> switched_solve(const std::string& formula,
+	const std::vector<std::string>& vars, size_t w)
+{
+	env_guard on("TAU_CONCRETE_EVAL", "1");
+	auto r = tau_api::solve(formula, solver_mode::general);
+	if (!r.has_value()) return std::nullopt;
+	std::vector<uint64_t> out;
+	for (const auto& v : vars) {
+		std::optional<uint64_t> found;
+		for (const auto& [name, value] : r.value())
+			if (name == v || name.rfind(v + ":", 0) == 0)
+				found = read_value(value, w);
+		if (!found) return std::nullopt;
+		out.push_back(*found);
+	}
+	return out;
+}
+
+struct admitted {
+	std::shared_ptr<concrete_evaluator_iface<node_t>> ev;
+	std::string reason;
+	// evaluate a valuation given by input name (`i1[t]`, ...); output
+	// values by output name
+	std::optional<std::vector<uint64_t>> run(
+		const std::vector<std::pair<std::string, uint64_t>>& inputs,
+		const std::vector<std::string>& outputs) const
+	{
+		if (!ev) return std::nullopt;
+		std::vector<std::string> values(ev->def.input_names.size());
+		std::vector<bool> set(values.size(), false);
+		// an input the admitted definition does not read (simplified
+		// away, as i2 under a constant guard) is ignored; every input it
+		// does read must be given
+		for (const auto& [name, v] : inputs)
+			for (size_t i = 0; i < ev->def.input_names.size(); ++i)
+				if (ev->def.input_names[i] == name)
+					values[i] = std::to_string(v), set[i] = true;
+		for (bool b : set) if (!b) return std::nullopt;
+		for (size_t i = 0; i < values.size(); ++i)
+			if (!ev->check_input(i, values[i])) return std::nullopt;
+		auto out = ev->evaluate(values);
+		if (!out) return std::nullopt;
+		std::vector<uint64_t> result;
+		for (const auto& o : outputs) {
+			bool found = false;
+			for (size_t k = 0; k < ev->def.output_names.size(); ++k)
+				if (ev->def.output_names[k] == o) {
+					result.push_back(std::stoull(out->decimals[k]));
+					found = true;
+				}
+			if (!found) return std::nullopt;
+		}
+		return result;
+	}
+};
+
+// Parse `source` as a spec and admit it as the REPL's evalspec would.
+admitted admit(const std::string& source) {
+	env_guard on("TAU_CONCRETE_EVAL", "1");
+	auto& defs = definitions<node_t>::instance();
+	auto snapshot = defs.save();
+	admitted a;
+	auto p = tau_api::get_spec_as_written(source);
+	if (!p.has_value()) a.reason = "parse_failed";
+	else {
+		// as the REPL assembles `evalspec %N`: the history entry alone
+		// when no definitions were entered
+		tau_spec<node_t> spec;
+		spec.add(p.value());
+		a.ev = tau_api::admit_concrete_evaluator(spec, a.reason);
+	}
+	defs.restore(std::move(snapshot));
+	return a;
+}
+
+// All (a, b) in [0, 2^w)^2.
+struct valuations {
+	size_t w;
+	template <typename F> void each(F f) const {
+		for (uint64_t a = 0; a <= top(w); ++a)
+			for (uint64_t b = 0; b <= top(w); ++b) f(a, b);
+	}
+};
+
+const std::vector<std::string> binary_terms = {
+	"&", "|", "^", "+", "-", "*", "/", "%", "<<", ">>", "!&", "!|", "!^" };
+const std::vector<std::string> comparisons = {
+	"=", "!=", "<", "!<", "<=", "!<=", ">", "!>", ">=", "!>=" };
+
+std::string op_term(const std::string& op, const std::string& l,
+	const std::string& r)
+{
+	if (op == "min" || op == "max") return op + "(" + l + ", " + r + ")";
+	if (op == "'") return "(" + l + ")'";
+	return "(" + l + " " + op + " " + r + ")";
+}
+
+} // namespace
