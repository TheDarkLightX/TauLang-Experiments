+			return form;
+		};
+		for (size_t w = 1; w <= 3; ++w) for (const auto& cmp : comparisons)
+			for (const auto& form : forms)
+		{
+			const std::string i1 = "i1[t]" + bvt(w), i2 = "i2[t]" + bvt(w);
+			const std::string o1 = "o1[t]" + bvt(w);
+			admitted a = admit("always " + instantiate(form,
+				i1 + " " + cmp + " " + i2,
+				o1 + " = (" + i1 + " + " + i2 + ")",
+				o1 + " = (" + i1 + " & " + i2 + ")") + ".");
+			REQUIRE_MESSAGE(a.ev, cmp << " " << form << " w " << w << ": "
+				<< a.reason);
+			valuations{w}.each([&](uint64_t x, uint64_t y) {
+				const std::string cx = cst(x, w), cy = cst(y, w);
+				const std::string ground = instantiate(form,
+					cx + " " + cmp + " " + cy,
+					"x" + bvt(w) + " = (" + cx + " + " + cy + ")",
+					"x" + bvt(w) + " = (" + cx + " & " + cy + ")");
+				auto expect = oracle(ground, {"x"}, w);
+				REQUIRE_MESSAGE(expect, "oracle failed: " << ground);
+				auto got = a.run({{"i1[t]", x}, {"i2[t]", y}}, {"o1[t]"});
+				REQUIRE_MESSAGE(got, "evaluation failed: " << ground);
+				CHECK_MESSAGE(*got == *expect, ground << " evaluator "
+					<< (*got)[0] << " solver " << (*expect)[0]);
+			});
+		}
+	}
+
+	// Every wff connective over two comparison atoms as a guard, plus
+	// negation and a nested conditional guard.
+	TEST_CASE_FIXTURE(api_fixture, "guard connectives") {
+		const std::vector<std::string> guards = {
+			"(P && Q)", "(P || Q)", "(P -> Q)", "(P <-> Q)", "(P ^^ Q)",
+			"!P", "(P ? Q : !Q)", "T", "F" };
+		for (size_t w = 1; w <= 3; ++w) for (const auto& guard : guards) {
+			auto with = [&](const std::string& l1, const std::string& l2,
+				const std::string& k)
+			{
+				std::string g = guard;
+				for (size_t p; (p = g.find('P')) != std::string::npos;)
+					g.replace(p, 1, "(" + l1 + " < " + l2 + ")");
+				for (size_t p; (p = g.find('Q')) != std::string::npos;)
+					g.replace(p, 1, "(" + l1 + " = " + k + ")");
+				return g;
+			};
+			const std::string i1 = "i1[t]" + bvt(w), i2 = "i2[t]" + bvt(w);
+			const std::string o1 = "o1[t]" + bvt(w);
+			admitted a = admit("always (" + with(i1, i2, cst(1, w))
+				+ " ? " + o1 + " = " + i1 + " : " + o1 + " = " + i2 + ").");
+			REQUIRE_MESSAGE(a.ev, guard << " w " << w << ": " << a.reason);
+			valuations{w}.each([&](uint64_t x, uint64_t y) {
+				const std::string cx = cst(x, w), cy = cst(y, w);
+				const std::string ground = "(" + with(cx, cy, cst(1, w))
+					+ " ? x" + bvt(w) + " = " + cx + " : x" + bvt(w)
+					+ " = " + cy + ")";
+				auto expect = oracle(ground, {"x"}, w);
+				REQUIRE_MESSAGE(expect, "oracle failed: " << ground);
+				auto got = a.run({{"i1[t]", x}, {"i2[t]", y}}, {"o1[t]"});
+				REQUIRE_MESSAGE(got, "evaluation failed: " << ground);
+				CHECK_MESSAGE(*got == *expect, ground << " evaluator "
+					<< (*got)[0] << " solver " << (*expect)[0]);
+			});
+		}
+	}
+
+	// A nested conditional DAG with two outputs where one leaf defines
+	// o2 from o1 (the checked intra-leaf dependency order).
+	TEST_CASE_FIXTURE(api_fixture, "nested decisions and output dependency") {
+		for (size_t w = 1; w <= 3; ++w) {
+			const std::string i1 = "i1[t]" + bvt(w), i2 = "i2[t]" + bvt(w);
+			const std::string o1 = "o1[t]" + bvt(w), o2 = "o2[t]" + bvt(w);
+			admitted a = admit("always ((" + i1 + " < " + i2 + ") ? ((" + i1
+				+ " = " + cst(0, w) + ") ? (" + o2 + " = (" + o1 + " * " + i2
+				+ ") && " + o1 + " = (" + i1 + " + " + i2 + ")) : (" + o1
+				+ " = " + i2 + " && " + o2 + " = " + o1 + ")) : (" + o1
+				+ " = (" + i1 + " - " + i2 + ") && " + o2 + " = (" + o1
+				+ " ^ " + i1 + "))).");
+			REQUIRE_MESSAGE(a.ev, "w " << w << ": " << a.reason);
+			CHECK(a.ev->def.branches.size() == 2);
+			CHECK(a.ev->def.leaves.size() == 3);
+			valuations{w}.each([&](uint64_t x, uint64_t y) {
+				const std::string cx = cst(x, w), cy = cst(y, w);
+				const std::string X = "x" + bvt(w), Y = "y" + bvt(w);
+				const std::string ground = "((" + cx + " < " + cy + ") ? (("
+					+ cx + " = " + cst(0, w) + ") ? (" + Y + " = (" + X + " * "
+					+ cy + ") && " + X + " = (" + cx + " + " + cy + ")) : ("
+					+ X + " = " + cy + " && " + Y + " = " + X + ")) : (" + X
+					+ " = (" + cx + " - " + cy + ") && " + Y + " = (" + X
+					+ " ^ " + cx + ")))";
+				auto expect = oracle(ground, {"x", "y"}, w);
+				REQUIRE_MESSAGE(expect, "oracle failed: " << ground);
+				auto got = a.run({{"i1[t]", x}, {"i2[t]", y}},
+					{"o1[t]", "o2[t]"});
+				REQUIRE_MESSAGE(got, "evaluation failed: " << ground);
+				CHECK_MESSAGE(*got == *expect, ground << " evaluator "
+					<< (*got)[0] << "," << (*got)[1] << " solver "
+					<< (*expect)[0] << "," << (*expect)[1]);
+			});
+		}
+	}
+}
+
+TEST_SUITE("concrete evaluator: near misses decline") {
+
+	TEST_CASE_FIXTURE(api_fixture, "shapes outside the admitted language") {
+		const std::string w = bvt(2);
+		const std::string i1 = "i1[t]" + w, i2 = "i2[t]" + w;
+		const std::string o1 = "o1[t]" + w, o2 = "o2[t]" + w;
+		struct near_miss { const char* what; std::string source; };
+		const std::vector<near_miss> cases = {
+			{ "free non-output variable in a guard",
+				"always ((" + i1 + " < y" + w + ") ? " + o1 + " = " + i1
+				+ " : " + o1 + " = " + i2 + ")." },
+			{ "output variable in a guard",
+				"always ((" + o1 + " < " + i1 + ") ? " + o1 + " = " + i1
+				+ " : " + o1 + " = " + i2 + ")." },
+			{ "output defined twice in a leaf",
+				"always (" + o1 + " = " + i1 + " && " + o1 + " = " + i2 + ")." },
+			{ "output missing in a leaf",
+				"always ((" + i1 + " < " + i2 + ") ? (" + o1 + " = " + i1
+				+ " && " + o2 + " = " + i2 + ") : " + o1 + " = " + i2 + ")." },
+			{ "cycle between outputs",
+				"always (" + o1 + " = (" + o2 + " + " + i1 + ") && " + o2
+				+ " = " + o1 + ")." },
+			{ "self-dependency",
+				"always " + o1 + " = (" + o1 + " + " + i1 + ")." },
+			{ "lookback input",
+				"always " + o1 + " = i1[t-1]" + w + "." },
+			{ "lookback output",
+				"always " + o1 + " = (o1[t-1]" + w + " + " + i1 + ")." },
+			{ "existential quantifier",
+				"always ex y" + w + " " + o1 + " = (y" + w + " + " + i1 + ")." },
+			{ "universal quantifier",
+				"always all y" + w + " " + o1 + " = (y" + w + " & " + i1 + ")." },
+			{ "sometimes instead of always",
+				"sometimes " + o1 + " = " + i1 + "." },
+			{ "sbf-typed output",
+				"always o1[t]:sbf = i1[t]:sbf." },
+			{ "no output definition at all",
+				"always " + i1 + " = " + i2 + "." },
+			{ "disjunction of leaves without a guard",
+				"always (" + o1 + " = " + i1 + " || " + o1 + " = " + i2 + ")." },
+		};
+		for (const auto& c : cases) {
+			admitted a = admit(c.source);
+			CHECK_MESSAGE(!a.ev, c.what << " was admitted: " << c.source);
+			const bool declined = a.reason == "not_admissible"
+				|| a.reason == "parse_failed"
+				|| a.reason == "definitions_failed";
+			CHECK_MESSAGE(declined, c.what << ": reason " << a.reason);
+		}
+	}
+
+	// The admission budget: a definition over the expression budget is
+	// declined with the over_budget reason; the same one is admitted
+	// under a budget that fits it.
+	TEST_CASE_FIXTURE(api_fixture, "admission budget is fail-closed") {
+		const std::string w = bvt(2);
+		const std::string source = "always ((i1[t]" + w + " < i2[t]" + w
+			+ ") ? o1[t]" + w + " = (i1[t]" + w + " + i2[t]" + w + ") : o1[t]"
+			+ w + " = (i1[t]" + w + " & i2[t]" + w + ")).";
+		{
+			env_guard budget("TAU_CONCRETE_EVAL_MAX_EXPRESSIONS", "4");
+			admitted a = admit(source);
+			CHECK(!a.ev);
+			CHECK(a.reason == "over_budget");
+		}
+		{
+			env_guard budget("TAU_CONCRETE_EVAL_MAX_EXPRESSIONS", "64");
+			admitted a = admit(source);
+			REQUIRE_MESSAGE(a.ev, a.reason);
+			CHECK(a.ev->def.expression_count <= 64);
+			CHECK(a.ev->retained_terms > 0);
+		}
+	}
+
+	TEST_CASE_FIXTURE(api_fixture, "admission budget exact boundary") {
+		const std::string source = "always o1[t]:bv[2] = i1[t]:bv[2].";
+		size_t expressions = 0;
+		{
+			env_guard budget("TAU_CONCRETE_EVAL_MAX_EXPRESSIONS", "64");
+			auto a = admit(source);
+			REQUIRE_MESSAGE(a.ev, a.reason);
+			expressions = a.ev->def.expression_count;
+			REQUIRE(expressions > 1);
+		}
+		for (size_t limit : {expressions - 1, expressions, expressions + 1}) {
+			const std::string text = std::to_string(limit);
+			env_guard budget("TAU_CONCRETE_EVAL_MAX_EXPRESSIONS", text.c_str());
+			auto a = admit(source);
+			CAPTURE(limit);
+			if (limit < expressions) {
+				CHECK_FALSE(a.ev);
+				CHECK(a.reason == "over_budget");
+			} else {
+				REQUIRE_MESSAGE(a.ev, a.reason);
+				CHECK(a.ev->def.expression_count == expressions);
+				CHECK(a.ev->def.expression_count <= limit);
+				auto out = a.run({{"i1[t]", 3}}, {"o1[t]"});
+				REQUIRE(out);
+				CHECK((*out)[0] == 3);
+			}
+		}
+	}
+
+	// Strict input reading: only canonical unsigned decimals below 2^w.
+	TEST_CASE_FIXTURE(api_fixture, "strict decimal inputs") {
+		admitted a = admit("always o1[t]:bv[3] = i1[t]:bv[3].");
+		REQUIRE_MESSAGE(a.ev, a.reason);
+		CHECK(a.ev->check_input(0, "0"));
+		CHECK(a.ev->check_input(0, "7"));
+		CHECK_FALSE(a.ev->check_input(0, "8"));
+		CHECK_FALSE(a.ev->check_input(0, "07"));
+		CHECK_FALSE(a.ev->check_input(0, "-1"));
+		CHECK_FALSE(a.ev->check_input(0, "+1"));
+		CHECK_FALSE(a.ev->check_input(0, ""));
+		CHECK_FALSE(a.ev->check_input(0, "1x"));
+		CHECK_FALSE(a.ev->check_input(0, "99999999999999999999999999"));
+		CHECK_FALSE(a.ev->check_input(1, "0"));   // no such slot
+		CHECK(decimal_pow2(0) == "1");
+		CHECK(decimal_pow2(32) == "4294967296");
+		CHECK(decimal_pow2(64) == "18446744073709551616");
+		CHECK(strict_unsigned_decimal("4294967295", decimal_pow2(32)));
+		CHECK_FALSE(strict_unsigned_decimal("4294967296", decimal_pow2(32)));
+	}
+
+	// A declined ground formula keeps the ordinary solver's answer with the
+	// switch on.
+	TEST_CASE_FIXTURE(api_fixture, "declined solve falls back") {
+		const std::string ground = "x:bv[2] = (y:bv[2] + {1}:bv[2]) && y:bv[2] = {2}:bv[2]";
+		auto off = oracle(ground, {"x", "y"}, 2);
+		auto on = switched_solve(ground, {"x", "y"}, 2);
+		REQUIRE(off);
+		REQUIRE(on);
+		CHECK(*on == *off);
+	}
+}
