@@ -0,0 +1,65 @@
+# TAU_CONCRETE_EVAL=1 `evalspec %N [value ...]` (heuristics/concrete_eval.h):
+# the response frame, its strict input reading and its declines.  The
+# evaluator's backend is bv's; a pack without bv declines with no_backend.
+
+# Each case is a list of REPL lines fed one per line on stdin (as a user
+# types them): `-e` would put the spec and `evalspec` on ONE line, which the
+# command parser then reads, bypassing evalspec.  printf's format is '%s\n'
+# so that `%N` in a line is not taken as a printf directive.
+function(add_evalspec_test test_name test_env test_regex)
+	set(quoted "")
+	foreach(line ${ARGN})
+		string(APPEND quoted " '${line}'")
+	endforeach()
+	add_test(NAME "test_repl-${test_name}"
+		COMMAND bash -c "printf '%s\\n'${quoted} q | env TAU_CONCRETE_EVAL=1 ${test_env} $<TARGET_FILE:${TAU_EXECUTABLE_NAME}>")
+	set_tests_properties("test_repl-${test_name}" PROPERTIES
+		PASS_REGULAR_EXPRESSION "${test_regex}")
+endfunction()
+
+set(_spec "always o1[t]:bv[2] = (i1[t]:bv[2] + i2[t]:bv[2])")
+
+if(bv IN_LIST TAU_PACK_BA_IDS)
+	add_evalspec_test(evalspec-admitted "" "evalspec-result: status=admitted inputs=2 outputs=1 decisions=0 leaves=1 expressions=[0-9]+ retained_terms=[0-9]+ budget=[0-9]+\nevalspec-end"
+		"${_spec}." "evalspec %1")
+	add_evalspec_test(evalspec-ok "" "evalspec-result: status=ok leaf=0 outputs=1 o1\\[t\\]=1\nevalspec-end"
+		"${_spec}." "evalspec %1 3 2")
+	add_evalspec_test(evalspec-arity "" "evalspec-result: status=error reason=arity\nevalspec-end"
+		"${_spec}." "evalspec %1 3")
+	add_evalspec_test(evalspec-overflow "" "evalspec-result: status=error reason=bad_value\nevalspec-end"
+		"${_spec}." "evalspec %1 4 0")
+	add_evalspec_test(evalspec-leading_zero "" "evalspec-result: status=error reason=bad_value\nevalspec-end"
+		"${_spec}." "evalspec %1 03 0")
+	add_evalspec_test(evalspec-junk "" "evalspec-result: status=error reason=bad_value\nevalspec-end"
+		"${_spec}." "evalspec %1 3 x")
+	add_evalspec_test(evalspec-huge_value "" "evalspec-result: status=error reason=bad_value\nevalspec-end"
+		"${_spec}." "evalspec %1 99999999999999999999999999999999 0")
+	add_evalspec_test(evalspec-over_budget "TAU_CONCRETE_EVAL_MAX_EXPRESSIONS=1"
+		"evalspec-result: status=error reason=over_budget\nevalspec-end"
+		"${_spec}." "evalspec %1 3 2")
+	# a definition shadowed by an earlier one of the same head unfolds as
+	# under `run %1` (the first one applies: o1[0] := 4 there), whether it
+	# comes before the spec, or after the spec was already admitted
+	set(_f1 "f(x:bv[4]) := x + {1}:bv[4].")
+	set(_f2 "f(x:bv[4]) := x + {2}:bv[4].")
+	set(_fspec "always o1[t]:bv[4] = f(i1[t]:bv[4]).")
+	add_evalspec_test(evalspec-shadowed_def ""
+		"evalspec-result: status=ok leaf=0 outputs=1 o1\\[t\\]=4\nevalspec-end"
+		"${_f1}" "${_f2}" "${_fspec}" "evalspec %1 3")
+	add_evalspec_test(evalspec-def_after_admission ""
+		"o1\\[t\\]=4\nevalspec-end\n.*evalspec-result: status=ok leaf=0 outputs=1 o1\\[t\\]=4\nevalspec-end"
+		"${_f1}" "${_fspec}" "evalspec %1 3" "${_f2}" "evalspec %1 3")
+	add_evalspec_test(evalspec-declined "" "evalspec-result: status=error reason=not_admissible\nevalspec-end"
+		"always (o1[t]:bv[2] = i1[t]:bv[2] || o1[t]:bv[2] = i2[t]:bv[2])." "evalspec %1")
+else()
+	add_evalspec_test(evalspec-no_backend "" "evalspec-result: status=error reason=no_backend\nevalspec-end"
+		"always o1[t]:sbf = i1[t]:sbf." "evalspec %1")
+endif()
+add_evalspec_test(evalspec-usage "" "evalspec-result: status=error reason=usage\nevalspec-end"
+	"evalspec")
+add_evalspec_test(evalspec-no_history "" "evalspec-result: status=error reason=bad_history\nevalspec-end"
+	"evalspec %1")
+add_evalspec_test(evalspec-huge_history "" "evalspec-result: status=error reason=bad_history\nevalspec-end"
+	"evalspec %99999999999999999999999999999")
+add_evalspec_test(evalspec-zero_history "" "evalspec-result: status=error reason=bad_history\nevalspec-end"
+	"evalspec %0")
