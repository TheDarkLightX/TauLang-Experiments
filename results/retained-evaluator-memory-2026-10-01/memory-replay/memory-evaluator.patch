diff --git a/src/boolean_algebras/bv/heuristics/bv_concrete_eval.h b/src/boolean_algebras/bv/heuristics/bv_concrete_eval.h
new file mode 100644
index 00000000..0b88b85b
--- /dev/null
+++ b/src/boolean_algebras/bv/heuristics/bv_concrete_eval.h
@@ -0,0 +1,211 @@
+// To view the license please visit https://github.com/IDNI/tau-lang/blob/main/LICENSE.md
+
+#ifndef __IDNI__TAU__BV_CONCRETE_EVAL_H__
+#define __IDNI__TAU__BV_CONCRETE_EVAL_H__
+
+// The bv backend of heuristics/concrete_eval.h.  The admitted DAG is
+// translated once into cvc5 terms by the bv translator the solver uses
+// (bv_eval_node); the guards become one ite chain selecting a leaf index.
+// Each evaluation substitutes the input values and normalizes
+// (normalize_bv, the same cvc5 simplification the constant-folding hooks
+// use) the selector and the selected leaf's output terms, in the leaf's
+// checked dependency order.  Any translation or evaluation failure is a
+// decline: the caller keeps the existing path.  Reached only through
+// ba_descriptor<bv, node>::concrete_evaluator, so a pack without bv never
+// sees cvc5 here.
+
+#include <functional>
+#include <array>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "heuristics/concrete_eval.h"
+
+namespace idni::tau_lang {
+
+template <NodeType node>
+struct bv_concrete_evaluator : concrete_evaluator_iface<node> {
+	using base = concrete_evaluator_iface<node>;
+	using tau = tree<node>;
+	using typename base::outcome;
+	std::vector<bv> input_consts;       // per input name
+	std::vector<bv> output_consts;      // per output name
+	bv selector;                        // bv[32] leaf index over the guards
+	std::vector<std::vector<bv>> leaf_terms;   // [leaf][output slot]
+	std::vector<bv> flat_leaf_terms;           // leaf-major contiguous slots
+
+	static std::shared_ptr<base> build(tref formula, bool allow_io,
+		size_t max_expressions)
+	{
+		auto recognized = recognize_concrete_definition<node>(formula,
+			allow_io, max_expressions);
+		if (!recognized) return nullptr;   // reject line set by the recognizer
+		auto ev = std::make_shared<bv_concrete_evaluator>();
+		ev->def = std::move(*recognized);
+		auto widths_of = [](const std::vector<size_t>& types,
+			std::vector<size_t>& widths)
+		{
+			for (size_t t : types) {
+				auto w = get_bv_width<node>(t);
+				if (!w.has_value() || !w.value()) return false;
+				widths.push_back(w.value());
+			}
+			return true;
+		};
+		if (!widths_of(ev->def.input_types, ev->input_widths)
+			|| !widths_of(ev->def.output_types, ev->output_widths))
+			CONCRETE_REJECT(nullptr);
+		for (size_t i = 0; i < ev->def.input_names.size(); ++i)
+			ev->input_consts.push_back(cvc5_term_manager.mkConst(
+				cvc5_term_manager.mkBitVectorSort(ev->input_widths[i]),
+				"in" + std::to_string(i)));
+		for (size_t i = 0; i < ev->def.output_names.size(); ++i)
+			ev->output_consts.push_back(cvc5_term_manager.mkConst(
+				cvc5_term_manager.mkBitVectorSort(ev->output_widths[i]),
+				"out" + std::to_string(i)));
+		subtree_map<node, bv> vars, free_vars;
+		for (const auto& ref : ev->def.inputs)
+			vars.emplace(ref.var, ev->input_consts[ref.slot]);
+		for (const auto& ref : ev->def.outputs)
+			vars.emplace(ref.var, ev->output_consts[ref.slot]);
+		size_t& terms_held = ev->retained_terms;
+		// terms and comparisons: the solver's own translator; a variable
+		// it did not find in `vars` would land in free_vars: a decline.
+		auto term = [&](tref t) -> std::optional<bv> {
+			auto r = bv_eval_node<node>(t, vars, free_vars);
+			if (!r.has_value() || !free_vars.empty()) CONCRETE_REJECT(std::nullopt);
+			++terms_held;
+			return r.value();
+		};
+		std::function<std::optional<bv>(tref)> wff;
+		wff = [&](tref w) -> std::optional<bv> {
+			const auto& op = tau::get(w)[0];
+			auto connective = [&](cvc5::Kind k, size_t n)
+				-> std::optional<bv>
+			{
+				std::vector<bv> args;
+				for (size_t i = 0; i < n; ++i) {
+					auto a = wff(op[i].get());
+					if (!a) CONCRETE_REJECT(std::nullopt);
+					args.push_back(*a);
+				}
+				++terms_held;
+				return cvc5_term_manager.mkTerm(k, args);
+			};
+			if (op.is(tau::wff_t)) return cvc5_term_manager.mkTrue();
+			if (op.is(tau::wff_f)) return cvc5_term_manager.mkFalse();
+			if (op.is(tau::wff_neg)) return connective(cvc5::Kind::NOT, 1);
+			if (op.is(tau::wff_and)) return connective(cvc5::Kind::AND, 2);
+			if (op.is(tau::wff_or)) return connective(cvc5::Kind::OR, 2);
+			if (op.is(tau::wff_imply))
+				return connective(cvc5::Kind::IMPLIES, 2);
+			if (op.is(tau::wff_equiv))
+				return connective(cvc5::Kind::EQUAL, 2);
+			if (op.is(tau::wff_xor)) return connective(cvc5::Kind::XOR, 2);
+			if (op.is(tau::wff_conditional))
+				return connective(cvc5::Kind::ITE, 3);
+			return term(w);
+		};
+		std::vector<std::optional<bv>> memo(ev->def.nodes.size());
+		std::function<std::optional<bv>(size_t)> select;
+		select = [&](size_t id) -> std::optional<bv> {
+			if (memo[id]) return memo[id];
+			const auto& n = ev->def.nodes[id];
+			if (n.is_leaf) return memo[id] = make_bitvector_value(32, n.index);
+			const auto& b = ev->def.branches[n.index];
+			auto g = wff(b.guard);
+			if (!g) CONCRETE_REJECT(std::nullopt);
+			auto yes = select(b.yes);
+			if (!yes) CONCRETE_REJECT(std::nullopt);
+			auto no = select(b.no);
+			if (!no) CONCRETE_REJECT(std::nullopt);
+			++terms_held;
+			return memo[id] = cvc5_term_manager.mkTerm(cvc5::Kind::ITE,
+				{*g, *yes, *no});
+		};
+		auto sel = select(0);
+		if (!sel) CONCRETE_REJECT(nullptr);
+		ev->selector = *sel;
+		const bool flat = memory_switch("TAU_EVAL_FLAT_LEAVES");
+		for (const auto& leaf : ev->def.leaves) {
+			if (leaf.terms.size() != ev->output_consts.size()) CONCRETE_REJECT(nullptr);
+			std::vector<bv> terms;
+			for (tref t : leaf.terms) {
+				auto v = term(t);
+				if (!v) CONCRETE_REJECT(nullptr);
+				terms.push_back(*v);
+			}
+			if (flat) ev->flat_leaf_terms.insert(ev->flat_leaf_terms.end(), terms.begin(), terms.end());
+			else ev->leaf_terms.push_back(std::move(terms));
+		}
+		return ev;
+	}
+
+	// One valuation (strict decimal text per input name, already checked
+	// by the caller) to one output tuple.
+	std::optional<outcome> evaluate(
+		const std::vector<std::string>& values,
+		bool materialize_constants = true) const override
+	{
+		if (values.size() != input_consts.size()) return std::nullopt;
+		std::vector<bv> vals;
+		for (size_t i = 0; i < values.size(); ++i) {
+			bv v = make_bitvector_value(this->input_widths[i], values[i], 10);
+			if (!v.isBitVectorValue()
+				|| v.getBitVectorValue(10) != values[i]) return std::nullopt;
+			vals.push_back(v);
+		}
+		auto substituted = [&](const bv& t, const std::vector<bv>& keys,
+			const std::vector<bv>& vs)
+		{
+			return keys.empty() ? t : t.substitute(keys, vs);
+		};
+		const bool memoize = !memory_switch("TAU_EVAL_TRANSIENT_NORMALIZE");
+		bv s = normalize_bv(substituted(selector, input_consts, vals), memoize);
+		if (!s.isBitVectorValue()) return std::nullopt;
+		size_t k = 0;
+		try { k = std::stoull(s.getBitVectorValue(10)); }
+		catch (const std::exception&) { return std::nullopt; }
+		if (k >= this->def.leaves.size()) return std::nullopt;
+		std::vector<bv> keys = input_consts;
+		alignas(std::optional<bv>) std::array<std::byte, 4096> storage;
+		output_scratch_resource heap;
+		std::pmr::monotonic_buffer_resource scratch(storage.data(), storage.size(), &heap);
+		std::pmr::vector<std::optional<bv>> out(output_consts.size(),
+			memory_switch("TAU_EVAL_ARENA_OUTPUTS")
+				? static_cast<std::pmr::memory_resource*>(&scratch) : &heap);
+		for (size_t o : this->def.leaves[k].order) {
+			const bv& term = flat_leaf_terms.empty() ? leaf_terms[k][o]
+				: flat_leaf_terms[k * output_consts.size() + o];
+			bv v = normalize_bv(substituted(term, keys, vals), memoize);
+			if (!v.isBitVectorValue()
+				|| v.getSort().getBitVectorSize() != this->output_widths[o])
+				return std::nullopt;
+			out[o] = v;
+			keys.push_back(output_consts[o]);
+			vals.push_back(v);
+		}
+		outcome result;
+		result.leaf = k;
+		for (size_t o = 0; o < out.size(); ++o) {
+			if (!out[o]) return std::nullopt;
+			result.decimals.push_back(out[o]->getBitVectorValue(10));
+			if (materialize_constants)
+				result.constants.push_back(constant_node(o, *out[o]));
+		}
+		return result;
+	}
+
+	// The Tau constant `{ v }:bv[w]` of output slot o.
+	tref constant_node(size_t o, const bv& v) const {
+		typename node::constant c = {v};
+		return tau::get(tau::bf, tau::get_ba_constant(c,
+			bv_type<node>(this->output_widths[o])));
+	}
+};
+
+} // namespace idni::tau_lang
+
+#endif // __IDNI__TAU__BV_CONCRETE_EVAL_H__
