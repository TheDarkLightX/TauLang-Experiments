+++ b/src/heuristics/memory_telemetry.h
@@ -0,0 +1,84 @@
+// To view the license please visit https://github.com/IDNI/tau-lang/blob/main/LICENSE.md
+#ifndef __IDNI__TAU__MEMORY_TELEMETRY_H__
+#define __IDNI__TAU__MEMORY_TELEMETRY_H__
+
+#include <cstdlib>
+#include <iostream>
+#include <memory_resource>
+#include <string_view>
+#ifdef __GLIBC__
+#include <malloc.h>
+#endif
+
+namespace idni::tau_lang {
+
+inline bool memory_switch(const char* name) {
+	const char* value = std::getenv(name);
+	return value && std::string_view(value) == "1";
+}
+
+struct memory_counters {
+	size_t normalize_hits = 0, normalize_misses = 0, normalize_bypasses = 0;
+	size_t normalize_entries = 0, trim_calls = 0, parse_scratch_releases = 0;
+	size_t output_scratch_heap_allocations = 0, output_scratch_heap_bytes = 0;
+};
+inline memory_counters memory_counts;
+
+struct output_scratch_resource final : std::pmr::memory_resource {
+	void* do_allocate(size_t bytes, size_t alignment) override {
+		void* p = std::pmr::new_delete_resource()->allocate(bytes, alignment);
+		if (memory_switch("TAU_MEMORY_TELEMETRY")) {
+			++memory_counts.output_scratch_heap_allocations;
+			memory_counts.output_scratch_heap_bytes += bytes;
+		}
+		return p;
+	}
+	void do_deallocate(void* p, size_t bytes, size_t alignment) override {
+		std::pmr::new_delete_resource()->deallocate(p, bytes, alignment);
+	}
+	bool do_is_equal(const std::pmr::memory_resource& other) const noexcept override {
+		return this == &other;
+	}
+};
+
+inline void emit_memory_telemetry(const char* phase, size_t pool_entries,
+	std::ostream& out, size_t tree_nodes) {
+	if (!memory_switch("TAU_MEMORY_TELEMETRY")) return;
+	out << "tau-memory: {\"phase\":\"" << phase
+		<< "\",\"constant_pool_entries\":" << pool_entries
+		<< ",\"interned_tree_nodes\":" << tree_nodes
+		<< ",\"normalizer_cache_entries\":" << memory_counts.normalize_entries
+		<< ",\"normalizer_hits\":" << memory_counts.normalize_hits
+		<< ",\"normalizer_misses\":" << memory_counts.normalize_misses
+		<< ",\"normalizer_bypasses\":" << memory_counts.normalize_bypasses
+		<< ",\"trim_calls\":" << memory_counts.trim_calls
+		<< ",\"parse_scratch_releases\":" << memory_counts.parse_scratch_releases
+		<< ",\"output_scratch_heap_allocations\":" << memory_counts.output_scratch_heap_allocations
+		<< ",\"output_scratch_heap_bytes\":" << memory_counts.output_scratch_heap_bytes;
+#if defined(__GLIBC__) && defined(__GLIBC_PREREQ)
+#if __GLIBC_PREREQ(2, 33)
+	// mallinfo2 walks allocator free lists. After scratch release those are
+	// large: scanning every valuation biases the candidate's measured cost.
+	// Full heap attribution belongs at explicit, quiescent phase boundaries.
+	if (std::string_view(phase) != "after_evaluation") {
+		const auto info = mallinfo2();
+		out << ",\"allocator_arena_live_bytes\":" << info.uordblks
+			<< ",\"allocator_arena_free_bytes\":" << info.fordblks
+			<< ",\"allocator_mmap_bytes\":" << info.hblkhd;
+	}
+#endif
+#endif
+	out << "}\n";
+}
+
+inline void reclaim_free_allocator_pages() {
+#ifdef __GLIBC__
+	if (memory_switch("TAU_EVAL_TRIM")) {
+		malloc_trim(0);
+		++memory_counts.trim_calls;
+	}
+#endif
+}
+
+} // namespace idni::tau_lang
+#endif
