# TauFold VM v1. Instruction semantics are authoritative in this file.
# Tables are fixed ADTs. select16/select32 are total unsigned lookup terms.
# A lookup mask is all ones exactly when n=j: min(n xor j,1)-1.
# Out-of-range indices are rejected by the instruction guards.
type Instruction = {opcode: bv[32], operand: bv[32]}.
type Code = {r0: Instruction, r1: Instruction, r2: Instruction, r3: Instruction, r4: Instruction, r5: Instruction, r6: Instruction, r7: Instruction, r8: Instruction, r9: Instruction, r10: Instruction, r11: Instruction, r12: Instruction, r13: Instruction, r14: Instruction, r15: Instruction, r16: Instruction, r17: Instruction, r18: Instruction, r19: Instruction, r20: Instruction, r21: Instruction, r22: Instruction, r23: Instruction, r24: Instruction, r25: Instruction, r26: Instruction, r27: Instruction, r28: Instruction, r29: Instruction, r30: Instruction, r31: Instruction}.
type Words = {r0: bv[32], r1: bv[32], r2: bv[32], r3: bv[32], r4: bv[32], r5: bv[32], r6: bv[32], r7: bv[32], r8: bv[32], r9: bv[32], r10: bv[32], r11: bv[32], r12: bv[32], r13: bv[32], r14: bv[32], r15: bv[32]}.
type Program = {code: Code, length: bv[32]}.
type Tape = {words: Words, length: bv[32]}.
type State = {accumulator: bv[32], pc: bv[32], memory: Words, input_cursor: bv[32], halted: bv[32]}.

select16(v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, n):bv[32] :=
    (v0 & (min((n ^ {0}:bv[32]), {1}:bv[32]) - {1}:bv[32])) |
    (v1 & (min((n ^ {1}:bv[32]), {1}:bv[32]) - {1}:bv[32])) |
    (v2 & (min((n ^ {2}:bv[32]), {1}:bv[32]) - {1}:bv[32])) |
    (v3 & (min((n ^ {3}:bv[32]), {1}:bv[32]) - {1}:bv[32])) |
    (v4 & (min((n ^ {4}:bv[32]), {1}:bv[32]) - {1}:bv[32])) |
