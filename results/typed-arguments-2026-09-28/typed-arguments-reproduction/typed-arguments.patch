--- /dev/null
+++ b/tests/unit/parser/test_ref_arg_types.cpp
@@ -0,0 +1,58 @@
+// To view the license please visit https://github.com/IDNI/tau-lang/blob/main/LICENSE.md
+
+#include "test_init.h"
+#include "test_tau_helpers.h"
+
+namespace {
+struct reset_definition_state {
+	reset_definition_state() {
+		definitions<node_t>::instance().clear();
+		api<node_t>::set_charvar(false);
+	}
+	~reset_definition_state() {
+		definitions<node_t>::instance().clear();
+		api<node_t>::set_charvar(true);
+	}
+};
+
+void check_definition(const char* source, bool expected) {
+	for (bool as_written : { false, true }) {
+		reset_definition_state state;
+		CAPTURE(std::string(source));
+		CAPTURE(as_written);
+		tau_spec<node_t> spec;
+		if (as_written) spec.keep_as_written();
+		REQUIRE(spec.parse(source));
+		CHECK(spec.get_nso_rr().has_value() == expected);
+	}
+}
+}
+
+TEST_CASE("typed expression arguments match their definition") {
+	for (const char* source : {
+		"g(x:sbf) := x:sbf = 0. g(0:sbf).",
+		"g(x:sbf) := x:sbf = 0. g(z:sbf).",
+		"g(x:sbf) := x:sbf = 0. g(z:sbf & 0:sbf).",
+		"g(x:sbf) := x:sbf = 0. g((sbf) z:sbf).",
+		"h(u:sbf) := u:sbf. g(x:sbf, y:tau) := (x:sbf = 0 && y:tau = 0). g(h(0:sbf), 0:tau).",
+		"g(x:tau) := x:tau = 0. g(0:tau)."
+	}) check_definition(source, true);
+#ifdef TAU_PACK_HAS_BA_BV
+	for (const char* source : {
+		"g(x:bv[2]) := x:bv[2]. g({1}:bv[2]) = {1}:bv[2].",
+		"g(x:bv[2]) := x:bv[2]. g(z:bv[2]) = {1}:bv[2].",
+		"g(x:bv[2]) := x:bv[2]. g(z:bv[2] & {3}:bv[2]) = {1}:bv[2].",
+		"g(x:bv[2]) := x:bv[2]. g((bv[2]) z:bv[2]) = {1}:bv[2].",
+		"h(u:bv[2]) := u:bv[2]. g(x:bv[2], y:sbf) := (x:bv[2] = {1}:bv[2] && y:sbf = 0). g(h({1}:bv[2]), 0:sbf).",
+		"g[0](x:bv[2]) := x:bv[2]. g[1]({1}:bv[2]) = {1}:bv[2]."
+	}) check_definition(source, true);
+#endif
+}
+
+TEST_CASE("incompatible argument types remain rejected") {
+	check_definition("g(x) := x:sbf = 0. g(z:tau).", false);
+	check_definition("g[0](x) := x:sbf = 0. g[1](x) := x:tau = 0. g[1](z:tau).", false);
+#ifdef TAU_PACK_HAS_BA_BV
+	check_definition("g(x:bv[2]) := x:bv[2] = 0. g({1}:bv[3]).", false);
+#endif
+}
