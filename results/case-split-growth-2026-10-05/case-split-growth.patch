+# --- GitHub #203: a rule whose condition tests twenty keyed inputs -----------
+# The reporter's flat disjunction at k = 20: each term compares the amount
+# with a threshold and one input with its key. The run closes the rule over
+# its inputs (universally) and the output (existentially); no key's instances
+# fold, so the bitvector case split copied the existential scope twice per
+# key, 2^20 times in all: the reporter's load passed 8 GB and was killed. The
+# split now gives the formula back when its instances would grow it past
+# bv-case-split-max-growth, and the solver decides it.
+# Generate the repeated terms so the thresholds, keys and input count are
+# visible without reading one long literal. The amount exceeds every threshold
+# and every key is absent, so the expected output is zero.
+set(_issue203_terms "")
+set(_issue203_inputs "20001\\n1")
+foreach(_issue203_j RANGE 20 1 -1)
+	math(EXPR _issue203_threshold "1000 * ${_issue203_j}")
+	math(EXPR _issue203_stream "17 + ${_issue203_j}")
+	math(EXPR _issue203_key "1 + ${_issue203_j}")
+	if(NOT _issue203_terms STREQUAL "")
+		string(APPEND _issue203_terms " || ")
+	endif()
+	string(APPEND _issue203_terms
+		"(i1[t]:bv[24] > { ${_issue203_threshold} }:bv[24] && !(i${_issue203_stream}[t]:bv[8] = { ${_issue203_key} }:bv[8]))")
+	string(APPEND _issue203_inputs "\\n0")
+endforeach()
+set(_issue203_rule
+	"run 1 steps always ((o1[t]:bv[24] = i1[t]:bv[24]) && ((i12[t]:bv[8] = { 1 }:bv[8]) ? ((${_issue203_terms}) ? o5[t]:bv[24] = { 0 }:bv[24] : o5[t]:bv[24] = { 1 }:bv[24]) : o5[t]:bv[24] = { 1 }:bv[24]))")
+add_raw_repl_test(run_cmd-issue203_keyed_terms_rule
+	"printf 'set charvar off\\n%s\\n${_issue203_inputs}\\n' '${_issue203_rule}' | ${TAU_RUN} -X"
+	"o5\\[0\\] := 0"
+	FAIL_REGEX "unsat|Error" REQUIRES bv TIMEOUT 60)
+
