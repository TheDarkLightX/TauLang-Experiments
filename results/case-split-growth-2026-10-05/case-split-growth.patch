 /// bv-case-split-max-tests.
 inline size_t bv_case_split_max_tests = std::numeric_limits<size_t>::max();
 
+/// Budget for the instances the case split builds in one formula, as a
+/// multiple of the formula's node count: a binder is charged the nodes its
+/// instances hold beyond the part of the scope they replace. An instance is
+/// cheap where the substituted tests fold. Where they do not, a binder copies
+/// its scope once per cell and nested binders multiply the copies: a rule
+/// that tests k inputs against one key each doubles per input (GitHub #203).
+/// A formula whose binders ask for more than the budget is returned as it
+/// came and left to the pipeline. SIZE_MAX = unlimited (0 through the option
+/// setter); set via --bv-case-split-max-growth or the REPL option
+/// bv-case-split-max-growth.
+/// This is a heuristic charge, not a bound on peak memory or result size:
+/// each instance is built before it is counted, joining nodes are not counted,
+/// and later simplification does not refund an earlier charge.
+inline size_t bv_case_split_max_growth = 8;
