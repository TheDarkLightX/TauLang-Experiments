 	return std::nullopt;
 }
 
+// The nodes below `root` that are not in `seen` yet, which takes them. Walked
+// as a DAG; BA constants are opaque, as in the occurrence scan.
+template <NodeType node>
+size_t count_nodes(tref root, std::unordered_set<tref>& seen) {
+	using tau = tree<node>;
+	size_t count = 0;
+	std::vector<tref> st{root};
+	while (!st.empty()) {
+		tref x = st.back(); st.pop_back();
+		if (!x || !seen.insert(x).second) continue;
+		++count;
+		const tau& tx = tau::get(x);
+		if (tx.is_ba_constant()) continue;
+		for (tref c : tx.children()) st.push_back(c);
+	}
+	return count;
+}
+
 } // namespace bv_case_split_detail
 
