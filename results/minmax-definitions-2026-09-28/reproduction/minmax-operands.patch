diff --git a/tests/repl/commands/test_repl-minmax_operands.cmake b/tests/repl/commands/test_repl-minmax_operands.cmake
new file mode 100644
index 00000000..430e2592
--- /dev/null
+++ b/tests/repl/commands/test_repl-minmax_operands.cmake
@@ -0,0 +1,22 @@
+include(add_repl_test)
+
+add_repl_test(minmax_operands-widen_max
+    "sat ((bv[4]) max(y:bv[3], {1}:bv[3])) = {2}:bv[4]." ": T")
+add_repl_test(minmax_operands-widen_min
+    "sat ((bv[4]) min(y:bv[3], {3}:bv[3])) = {2}:bv[4]." ": T")
+add_repl_test(minmax_operands-narrow_max
+    "sat ((bv[2]) max(y:bv[3], {1}:bv[3])) = {2}:bv[2]." ": T")
+add_repl_test(minmax_operands-ground_cast
+    "normalize ((bv[4]) max({2}:bv[3], {1}:bv[3])) = {2}:bv[4]." ": T")
+add_repl_test(minmax_operands-invalid_disequality
+    "valid ((bv[4]) max(y:bv[3], {1}:bv[3])) != {2}:bv[4]." ": F")
+add_repl_test(minmax_operands-complement_min
+    "sat min(x:bv[2], {2}:bv[2])' = {2}:bv[2]." ": T")
+add_repl_test(minmax_operands-complement_max
+    "sat max(x:bv[2], {1}:bv[2])' = {1}:bv[2]." ": T")
+add_repl_test(minmax_operands-quantified_complement
+    "sat all x:bv[3] ex b:bv[3] (min(x, b)' = x')." ": T")
+add_repl_test(minmax_operands-adjacent_functions
+    "normalize min({3}:bv[3], {5}:bv[3])max({2}:bv[3], {4}:bv[3]) = {0}:bv[3]." ": T")
+add_repl_test(minmax_operands-adjacent_constant
+    "normalize min({3}:bv[3], {5}:bv[3]){4}:bv[3] = {0}:bv[3]." ": T")
