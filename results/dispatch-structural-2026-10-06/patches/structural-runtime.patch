+// `ex x phi` where every occurrence of x is a disequality against a
+// closed term, reached only through connectives in which phi grows with
+// its tests: with fewer distinct terms than the type has values some value
+// of x differs from all of them, so `ex x phi` is phi with every test of x
+// true. The complement of a defined output has this shape
+// (`o != 0 && D || o != 1 && N`), and it reaches the case split as an
+// existential with nothing to define it, which the split then copies once
+// per case of every tested input (GitHub #203). An identity on the
+// formula; a binder it does not apply to is returned as it came.
+template <NodeType node>
+tref bv_eliminate_disequality_existential(tref binder) {
+	using tau = tree<node>;
+	const tau& b = tau::get(binder);
+	if (!(b.is(tau::wff) && b.child_is(tau::wff_ex))) return binder;
+	tref var = b[0].first(), scope = b[0].second();
+	const size_t type = tau::get(var).get_ba_type();
+	if (type == 0 || !is_bv_type_family<node>(type)) return binder;
+	auto width = get_bv_width<node>(type);
+	if (!width.has_value()) return binder;
+	// every atom holding x is `x = c` under a negation, or `x != c`
+	subtree_set<node> consts;
+	std::vector<tref> tests;
+	bool ok = true;
+	auto decline = [&](const char*, tref) { ok = false; };
+	// walk the wff connectives; a test of x is recorded, anything else
+	// that mentions x declines the binder
+	std::function<void(tref)> visit = [&](tref n) {
+		if (!ok || !contains<node>(n, var)) return;
+		const tau& t = tau::get(n);
+		if (!t.is(tau::wff)) { decline("not a wff", n); return; }
+		const bool neg = t.child_is(tau::wff_neg);
+		tref atom = neg ? t[0].first() : n;
+		const tau& a = tau::get(atom);
+		if (a.is(tau::wff) && (a.child_is(tau::bf_eq) || a.child_is(tau::bf_neq))) {
+			if (neg == a.child_is(tau::bf_neq)) { decline("equality", n); return; }
+			tref l = a[0][0][0].get(), r = a[0][1][0].get();
+			const bool lv = tau::get(l) == tau::get(var);
+			const bool rv = tau::get(r) == tau::get(var);
+			if (lv == rv) { decline("both or neither side", n); return; }
+			// the other side is a closed term
+			tref c = lv ? a[0][1].get() : a[0][0].get();
+			if (!tau::get(c).get_free_vars().empty()
+				|| tau::get(c).find_top(is<node, tau::uconst_name>)) {
+				decline("open other side", n); return;
+			}
+			consts.insert(c);
+			tests.push_back(n);
+			return;
+		}
+		// only where the formula grows with its tests: both sides of a
+		// conjunction or disjunction, the consequent of an implication and
+		// the branches of a conditional, with x absent from the rest
+		const tau& c = t[0];
+		if (t.child_is(tau::wff_and) || t.child_is(tau::wff_or)) {
+			for (size_t i = 0; i < c.children_size() && ok; ++i)
+				visit(c.child(i));
+		} else if (t.child_is(tau::wff_imply)) {
+			if (contains<node>(c.first(), var)) { ok = false; return; }
+			visit(c.second());
+		} else if (t.child_is(tau::wff_rimply)) {
+			if (contains<node>(c.second(), var)) { ok = false; return; }
+			visit(c.first());
+		} else if (t.child_is(tau::wff_conditional)) {
+			if (contains<node>(c.child(0), var)) { ok = false; return; }
+			visit(c.child(1)); visit(c.child(2));
+		} else if (t.child_is(tau::wff_ex) || t.child_is(tau::wff_all)) {
+			// The forbidden terms are closed, so one fixed witness works
+			// for every value of this other variable. A shadowing binder
+			// is deliberately left to the normal scope-aware pipeline.
+			if (tau::get(c.first()) == tau::get(var)) {
+				decline("shadowing binder", n); return;
+			}
+			visit(c.second());
+		} else decline("connective", n);
+	};
+	visit(scope);
+	if (!ok || tests.empty()) return binder;
+	// Avoid a shift by the width of size_t. A wider domain exceeds the
+	// number of distinct terms representable by this container.
+	if (width.value() < std::numeric_limits<size_t>::digits
+		&& consts.size() >= (size_t(1) << width.value()))
+		return binder;
+	subtree_set<node> test_set(tests.begin(), tests.end());
+	auto drop_test = [&](tref n) -> tref {
+		return test_set.contains(n) ? tau::_T() : n; };
+	return pre_order<node>(scope).apply_unique(drop_test);
+}
