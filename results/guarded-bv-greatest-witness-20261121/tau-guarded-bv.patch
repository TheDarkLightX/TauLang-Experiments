+
+TEST_SUITE("closed bitvector mask implications") {
+	TEST_CASE("a greatest witness decides every pair of two-bit mask implications") {
+		using K = cvc5::Kind;
+		auto& tm = cvc5_term_manager;
+		const auto x = tm.mkConst(tm.mkBitVectorSort(2), "x");
+		const auto zero = tm.mkBitVector(2, 0);
+		const auto deadline = std::chrono::steady_clock::time_point::max();
+		const auto nonzero = tm.mkTerm(K::DISTINCT, { x, zero });
+
+		auto masked = [&](unsigned m) {
+			return tm.mkTerm(K::BITVECTOR_AND, { tm.mkBitVector(2, m), x });
+		};
+		auto no_bits = [&](unsigned m) {
+			return tm.mkTerm(K::EQUAL, { zero, masked(m) });
+		};
+		auto rule = [&](unsigned u, unsigned v) {
+			// Reversed arms, commuted mask, and NOT(EQUAL) for nonzero.
+			return tm.mkTerm(K::OR, {
+				tm.mkTerm(K::NOT, { no_bits(v) }), no_bits(u) });
+		};
+
+		for (unsigned code = 0; code < 1024; ++code) {
+			const unsigned y = code & 3, u = (code >> 2) & 3,
+				v = (code >> 4) & 3, p = (code >> 6) & 3, q = code >> 8;
+			const auto matrix = tm.mkTerm(K::AND, {
+				nonzero, no_bits(y), rule(u, v), rule(p, q) });
+			bool expected = false;
+			for (unsigned b = 1; b < 4; ++b)
+				if (!(b & y) && (!(b & u) || (b & v))
+					&& (!(b & p) || (b & q))) expected = true;
+			CAPTURE(code);
+			const auto verdict = bv_guarded_witness_sat(matrix, x, deadline);
+			REQUIRE(verdict.has_value());
+			CHECK(*verdict == expected);
+		}
+	}
+
+	TEST_CASE("unsupported literals and widths decline even beside a recognized rule") {
+		using K = cvc5::Kind;
+		auto& tm = cvc5_term_manager;
+		const auto deadline = std::chrono::steady_clock::time_point::max();
+		for (unsigned width : { 64u, 65u }) {
+			const auto x = tm.mkConst(tm.mkBitVectorSort(width), "b");
+			const auto z = tm.mkBitVector(width, 0);
+			const auto one = tm.mkBitVector(width, 1);
+			const auto high = tm.mkBitVector(width, uint64_t{1} << 63);
+			const auto lo_bits = tm.mkBitVector(width, (uint64_t{1} << 63) - 1);
+			auto test = [&](const cvc5::Term& subject, const cvc5::Term& m, K relation) {
+				return tm.mkTerm(relation, { tm.mkTerm(K::BITVECTOR_AND, { subject, m }), z });
+			};
+			const auto nonzero = tm.mkTerm(K::DISTINCT, { x, z });
+			const auto upper = test(x, lo_bits, K::EQUAL);
+			const auto rule = tm.mkTerm(K::OR, {
+				test(x, high, K::EQUAL), test(x, one, K::DISTINCT) });
+			const auto matrix = tm.mkTerm(K::AND, { nonzero, upper, rule });
+			const auto answer = bv_guarded_witness_sat(matrix, x, deadline);
+			if (width == 65) {
+				CHECK_FALSE(answer.has_value());
+				continue;
+			}
+			// The highest bit is the only available bit and requires bit 0.
+			REQUIRE(answer.has_value());
+			CHECK_FALSE(*answer);
+			const auto negated = tm.mkTerm(K::BITVECTOR_NOT, { x });
+			const auto other = tm.mkConst(tm.mkBitVectorSort(width), "y");
+			const auto sum = tm.mkTerm(K::BITVECTOR_ADD, { x, one });
+			for (const auto& extra : { test(negated, one, K::DISTINCT),
+					test(other, one, K::DISTINCT), test(sum, one, K::DISTINCT) }) {
+				// Even though matrix is already inconsistent, admission must
+				// inspect the entire input before this path supplies a verdict.
+				const auto extended = tm.mkTerm(K::AND, { matrix, extra });
+				CHECK_FALSE(bv_guarded_witness_sat(extended, x, deadline).has_value());
+			}
+			const auto past = std::chrono::steady_clock::time_point::min();
+			CHECK_FALSE(bv_guarded_witness_sat(matrix, x, past).has_value());
+		}
+	}
+
+	TEST_CASE("the closed verdict path reaches the guard and the public SAT call agrees") {
+		// Banning bit 4 forces bit 2 out; the first implication then
+		// forces bit 1 out. Requiring bit 1 instead of bit 4 in the
+		// second consequent admits 3. All masks here are numeric masks.
+		auto sample = [](char name, unsigned consequent, unsigned forbidden = 4) {
+			const std::string x = std::string(1, name) + ":bv[3]";
+			const std::string zero = "{0}:bv[3]";
+			return "ex " + x + " (" + x + " != " + zero + " && (" + x + " & {"
+				+ std::to_string(forbidden) + "}:bv[3]) = " + zero
+				+ " && ((" + x + " & {1}:bv[3]) = " + zero + " || (" + x + " & {2}:bv[3]) != " + zero
+				+ ") && ((" + x + " & {2}:bv[3]) = " + zero + " || (" + x + " & {"
+				+ std::to_string(consequent) + "}:bv[3]) != " + zero + "))";
+		};
+		qf_config on(true);
+		for (unsigned consequent : { 4u, 1u }) {
+			const bool expected = consequent == 1;
+			auto fm = parse_wff_or_fail(sample('k', consequent));
+			const size_t before = bv_guarded_witness_decisions.load();
+			auto verdict = bv_formula_sat_status<node_t>(fm);
+			REQUIRE(verdict.has_value());
+			REQUIRE(verdict.value().has_value());
+			CHECK(*verdict.value() == (expected ? bv_sat_status::sat : bv_sat_status::unsat));
+			CHECK(bv_guarded_witness_decisions.load() == before + 1);
+
+			auto api_verdict = api<node_t>::sat(sample('j', consequent));
+			REQUIRE(api_verdict.has_value());
+			CHECK(api_verdict.value() == expected);
+		}
+
+		// Change the forbidden mask for each toggle: alpha-renaming a
+		// binder alone can yield the same canonical verdict-cache key.
+		auto expect_other_route = [&](char binder, unsigned forbidden, bv_sat_status expected) {
+			auto fm = parse_wff_or_fail(sample(binder, 4, forbidden));
+			const size_t before = bv_guarded_witness_decisions.load();
+			auto verdict = bv_formula_sat_status<node_t>(fm);
+			REQUIRE(verdict.has_value());
+			REQUIRE(verdict.value().has_value());
+			CHECK(*verdict.value() == expected);
+			CHECK(bv_guarded_witness_decisions.load() == before);
+		};
+		{
+			option_text_guard no_qf_bdd("bv-bitblast-qf-max-nodes", "0");
+			expect_other_route('u', 3, bv_sat_status::sat); // b=4 works
+		}
+		{
+			option_text_guard narrow("bv-bitblast-max-width", "2");
+			expect_other_route('v', 6, bv_sat_status::unsat); // b=1 would require bit 2
+		}
+	}
+
+	TEST_CASE("complemented input, a free coefficient and universal queries use the fallback") {
+		qf_config on(true);
+		const std::pair<const char*, bool> cases[] = {
+			// b=2 works: the complemented input supplies the required low bit.
+			{"ex b:bv[2] (b:bv[2] != {0}:bv[2] && (b:bv[2] & {1}:bv[2]) = {0}:bv[2] && "
+				"((b:bv[2] & {2}:bv[2]) = {0}:bv[2] || ((b:bv[2])' & {1}:bv[2]) != {0}:bv[2]))", true},
+			// The coefficient c is free; b=c=2 witnesses satisfiability.
+			{"ex b:bv[2] (b:bv[2] != {0}:bv[2] && (b:bv[2] & {1}:bv[2]) = {0}:bv[2] && "
+				"((b:bv[2] & {2}:bv[2]) = {0}:bv[2] || (b:bv[2] & c:bv[2]) != {0}:bv[2]))", true},
+			// b=0 violates the unconditional nonzero test.
+			{"all b:bv[2] (b:bv[2] != {0}:bv[2] && ((b:bv[2] & {1}:bv[2]) = {0}:bv[2] || "
+				"(b:bv[2] & {2}:bv[2]) != {0}:bv[2]))", false},
+		};
+		for (const auto& [sample, expected] : cases) {
+			CAPTURE(sample);
+			auto fm = parse_wff_or_fail(sample);
+			const size_t before = bv_guarded_witness_decisions.load();
+			auto verdict = bv_formula_sat_status<node_t>(fm);
+			REQUIRE(verdict.has_value());
+			REQUIRE(verdict.value().has_value());
+			CHECK(*verdict.value() == (expected ? bv_sat_status::sat : bv_sat_status::unsat));
+			CHECK(bv_guarded_witness_decisions.load() == before);
+		}
+	}
+
