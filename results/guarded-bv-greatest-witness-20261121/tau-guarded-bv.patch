index 0000000000000000000000000000000000000000..5791e9d511061e49a9e806193782ee972d21b8ae
--- /dev/null
+++ b/src/boolean_algebras/bv/heuristics/bv_guarded_witness.h
@@ -0,0 +1,124 @@
+// To view the license please visit https://github.com/IDNI/tau-lang/blob/main/LICENSE.md
+
+#ifndef __IDNI__TAU__BOOLEAN_ALGEBRAS__BV__GUARDED_WITNESS_H__
+#define __IDNI__TAU__BOOLEAN_ALGEBRAS__BV__GUARDED_WITNESS_H__
+
+#include <cvc5/cvc5.h>
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace idni::tau_lang {
+
+/// Number of cache misses decided by the guarded-witness rule.
+inline std::atomic_size_t bv_guarded_witness_decisions = 0;
+
+namespace bv_guarded_witness_detail {
+
+struct literal {
+	std::uint64_t mask;
+	bool nonzero;
+};
+
+/// Read exactly a same-width zero test on x or x & constant. Both operand
+/// orders are legal, and the translator can produce DISTINCT or NOT(EQUAL).
+inline std::optional<literal> read_literal(cvc5::Term atom,
+	const cvc5::Term& x, std::uint64_t top)
+{
+	using cvc5::Kind;
+	const bool negated = atom.getKind() == Kind::NOT;
+	if (negated) atom = atom[0];
+	const auto kind = atom.getKind();
+	if ((kind != Kind::EQUAL && kind != Kind::DISTINCT)
+		|| atom.getNumChildren() != 2) return std::nullopt;
+	auto expr = atom[0], zero = atom[1];
+	if (expr.isBitVectorValue()) std::swap(expr, zero);
+	if (!zero.isBitVectorValue() || zero.getSort() != x.getSort()
+		|| zero.getBitVectorValue(10) != "0") return std::nullopt;
+
+	const bool nonzero = (kind == Kind::DISTINCT) != negated;
+	if (expr == x) return literal{top, nonzero};
+	if (expr.getKind() != Kind::BITVECTOR_AND || expr.getNumChildren() != 2)
+		return std::nullopt;
+	auto variable = expr[0], mask = expr[1];
+	if (mask == x) std::swap(variable, mask);
+	if (variable != x || !mask.isBitVectorValue() || mask.getSort() != x.getSort())
+		return std::nullopt;
+	std::uint64_t value = 0;
+	for (char bit : mask.getBitVectorValue(2))
+		value = (value << 1) | static_cast<unsigned>(bit == '1');
+	return literal{value, nonzero};
+}
+
+} // namespace bv_guarded_witness_detail
+
+/// Decide conjunctive zero/nonzero tests and guarded implications of the form
+/// (x & u = 0 or x & v != 0) for concrete 1..64-bit masks. The caller
+/// establishes that x is the matrix's sole variable and is existential.
+/// A declined shape or elapsed deadline returns nullopt for the caller.
+inline std::optional<bool> bv_guarded_witness_sat(const cvc5::Term& matrix,
+	const cvc5::Term& x, std::chrono::steady_clock::time_point deadline)
+{
+	using cvc5::Kind;
+	using bv_guarded_witness_detail::read_literal;
+	using clock = std::chrono::steady_clock;
+	const auto late = [&] { return deadline != clock::time_point::max()
+		&& clock::now() >= deadline; };
+	if ((matrix.getKind() != Kind::AND && matrix.getKind() != Kind::OR)
+		|| x.getKind() != Kind::CONSTANT || !x.getSort().isBitVector())
+		return std::nullopt;
+	const auto width = x.getSort().getBitVectorSize();
+	if (!width || width > 64) return std::nullopt;
+	const auto top = width == 64 ? std::numeric_limits<std::uint64_t>::max()
+		: (std::uint64_t{1} << width) - 1;
+
+	std::uint64_t bound = top;
+	std::vector<std::uint64_t> required;
+	std::vector<std::pair<std::uint64_t, std::uint64_t>> guards;
+	std::vector<cvc5::Term> pending{matrix};
+	std::unordered_set<cvc5::Term> seen;
+	while (!pending.empty()) {
+		if (late()) return std::nullopt;
+		auto term = pending.back(); pending.pop_back();
+		if (!seen.insert(term).second) continue;
+		if (term.getKind() == Kind::AND) {
+			for (const auto& child : term) pending.push_back(child);
+		} else if (term.getKind() == Kind::OR && term.getNumChildren() == 2) {
+			auto a = read_literal(term[0], x, top);
+			auto b = read_literal(term[1], x, top);
+			if (!a || !b || a->nonzero == b->nonzero) return std::nullopt;
+			if (a->nonzero) std::swap(a, b);
+			guards.emplace_back(a->mask, b->mask);
+		} else if (auto a = read_literal(term, x, top)) {
+			if (a->nonzero) required.push_back(a->mask);
+			else bound &= ~a->mask;
+		} else return std::nullopt;
+	}
+	if (guards.empty()) return std::nullopt;
+	// Every witness is below bound. When bound avoids v, every witness
+	// must avoid u. Each strict pass clears at least one of at most 64 bits.
+	std::uint64_t before;
+	do {
+		before = bound;
+		for (auto [u, v] : guards) {
+			if (late()) return std::nullopt;
+			if ((bound & v) == 0) bound &= ~u;
+		}
+	} while (before != bound);
+	// At the fixed point bound satisfies every guard and zero test.
+	// A separate nonzero test holds somewhere iff it holds at bound.
+	for (auto mask : required) {
+		if (late()) return std::nullopt;
+		if ((bound & mask) == 0) return false;
+	}
+	return true;
+}
+
+} // namespace idni::tau_lang
+#endif
