+fn profile(program_path: &str, witness_path: &str) -> Result<()> {
+    reject_dev_mode()?;
+    let program: Program = read_json(program_path)?;
+    let witness: Witness = read_json(witness_path)?;
+    let expected = check_trace(&program, &witness)
+        .map_err(|error| anyhow::anyhow!("trace rejected: {error:?}"))?;
+    let input = ProofInput { program, witness };
+    let env = ExecutorEnv::builder().write(&input)?.session_limit(Some(1 << 24)).build()?;
+    let executable = std::env::var("TAUFOLD_R0VM").unwrap_or_else(|_| "r0vm".to_string());
+    let session = ExternalProver::new("taufold-profile", executable)
+        .execute(env, TAUFOLD_GUEST_ELF)?;
+    ensure!(session.exit_code == risc0_zkvm::ExitCode::Halted(0), "guest did not succeed");
+    let actual: Statement = session.journal.decode()?;
+    ensure!(actual == expected, "guest statement differs from independent host check");
+    print_json(&serde_json::json!({
+        "status":"executed_and_checked", "user_cycles":session.cycles(),
+        "segments":session.segments.iter().map(|s| serde_json::json!({"po2":s.po2,"cycles":s.cycles})).collect::<Vec<_>>(),
+        "guest_image_id":TAUFOLD_GUEST_ID, "steps":expected.steps,
+    }))
+}
